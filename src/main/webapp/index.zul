<?page title="GEDI" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <style src="/css/enmg-theme.css" />

    <!-- ✅ Styles pour la bannière et les boutons -->
    <style>
        .banner {
            position: fixed; top: 24px; left: 50%;
            transform: translateX(-50%);
            padding: 12px 18px;
            border-radius: var(--enmg-radius-md);
            box-shadow: var(--enmg-shadow-md);
            z-index: 1000;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--enmg-color-surface);
            border: 1px solid var(--enmg-color-border);
        }
        .banner--success { background: #ecfdf3; color: #166534; border: 1px solid #bbf7d0; }
        .banner--warn    { background: #fffbeb; color: #92400e; border: 1px solid #fef3c7; }
        .banner--error   { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
        .z-button:hover  { filter: brightness(0.95); }
        .z-button:active { transform: translateY(1px); }
        .z-button-content { font-size: 16px; font-weight: 600; }
        login-branding-logo{
            width:140px;
            align-self:center;
        }
    </style>

    <!--
        CORRECTION: Un seul composant parent (ce Div) possède le ViewModel.
        Tout ce qui est à l'intérieur (bannière ET fenêtre) peut y accéder
        en utilisant "vm"
    -->
    <div viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.IndexViewModel')">

        <!-- La bannière est un enfant direct, elle voit 'vm' sans problème -->
        <div id="flashBanner"
             sclass="@load(vm.bannerClass)"
             visible="@load(not empty vm.flashMessage)">
            <n:i sclass="@load(vm.bannerIconClass)" />
            <label value="@load(vm.flashMessage)" />
        </div>

        <!-- La fenêtre enfant -->
        <window
            title=""
            border="none"
            width="560px"
            closable="false"
            sizable="false"
            mode="modal"
            position="center"
            style="background:var(--enmg-color-surface);border-radius:14px;box-shadow:var(--enmg-shadow-md)">
            
            <vbox hflex="1" spacing="22px" align="center" style="padding:28px 56px">
                <image src="/img/login.png" width="80px" height="120px"/>
                <label value="Bienvenue dans votre espace documentaire" style="color:var(--enmg-color-text-soft)"/>

             
                <vbox spacing="14px" hflex="1" style="width:100%">
                    <button label="Documents" hflex="1"
                            sclass="enmg-btn enmg-btn-primary"
                            style="height:48px;"
                            iconSclass="z-icon-folder-o"
                            onClick="@command('goDocs')"
                            />

                   <!-- <button label="Bibliothèque" hflex="1"
                            iconSclass="z-icon-book"
                            onClick="@command('goBiblio')"
                            style="height:48px;background:#2E7D32;color:#fff;border:none;border-radius:8px"/> -->

                    <button label="Administration" hflex="1"
                            sclass="enmg-btn enmg-btn-primary"
                            style="height:48px;"
                            iconSclass="z-icon-cog"
                            visible="@load(vm.adminVisible)"
                            onClick="@command('goAdmin')"
                            />

                    <button label="Déconnexion" hflex="1"
                            sclass="enmg-btn enmg-btn-danger"
                            style="height:48px;"
                            iconSclass="z-icon-sign-out"
                            onClick="@command('logout')"/>
                </vbox>

                <hlayout spacing="12px">
                    <a label="Aide" onClick="@command('showHelp')"/>
                    <label value="·"/>
                    <a label="À propos" onClick="@command('showAbout')"/>
                </hlayout>
            </vbox>
        </window>

        <!-- AIDE -->
        <window title="Aide" width="520px" mode="modal" closable="true" visible="@load(vm.helpVisible)"
                onClose="@command('closeHelp')" border="normal" sclass="enmg-modal">
            <vbox spacing="10px" style="padding:18px;">
                <label value="Besoin d'aide ?" sclass="fw-bold"/>
                <label value="• Accédez à vos documents via le bouton Documents."/>
                <label value="• L'administration est réservée aux comptes autorisés."/>
                <label value="• Pour toute assistance, contactez le support ou un responsable concours."/>
                <hlayout hflex="1" style="justify-content:flex-end; gap:8px;">
                    <button label="Fermer" sclass="btn" onClick="@command('closeHelp')"/>
                </hlayout>
            </vbox>
        </window>

        <!-- A PROPOS -->
        <window title="À propos" width="520px" mode="modal" closable="true" visible="@load(vm.aboutVisible)"
                onClose="@command('closeAbout')" border="normal" sclass="enmg-modal">
            <vbox spacing="10px" style="padding:18px;">
                <label value="GEDI - Gestion documentaire ENMG" sclass="fw-bold"/>
                <label value="Version interne - Plateforme de gestion des candidatures et documents concours."/>
                <label value="Développé pour les équipes ENMG : cellule concours, responsables dossier et validation."/>
                <hlayout hflex="1" style="justify-content:flex-end; gap:8px;">
                    <button label="Fermer" sclass="btn" onClick="@command('closeAbout')"/>
                </hlayout>
            </vbox>
        </window>
    </div>
</zk>
