<?page title="GEDI" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">

    <!-- ✅ Styles pour la bannière et les boutons -->
    <style>
        .banner {
            position: fixed; top: 24px; left: 50%;
            transform: translateX(-50%);
            padding: 12px 18px;
            border-radius: 8px;
            box-shadow: 0 6px 18px rgba(0,0,0,.08);
            z-index: 1000;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .banner--success { background: #e6ffed; color: #1e7e34; border: 1px solid #c3e6cb; }
        .banner--warn    { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
        .banner--error   { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .z-button:hover  { filter: brightness(0.95); }
        .z-button:active { transform: translateY(1px); }
        .z-button-content { font-size: 16px; font-weight: 600; }
    </style>

    <!--
        CORRECTION: Un seul composant parent (ce Div) possède le ViewModel.
        Tout ce qui est à l'intérieur (bannière ET fenêtre) peut y accéder
        en utilisant "vm". C'est la solution la plus simple et la plus fiable.
    -->
    <div viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.IndexViewModel')">

        <!-- La bannière est un enfant direct, elle voit 'vm' sans problème -->
        <div id="flashBanner"
             sclass="@load(vm.bannerClass)"
             visible="@load(not empty vm.flashMessage)">
            <n:i sclass="@load(vm.bannerIconClass)" />
            <label value="@load(vm.flashMessage)" />
        </div>

        <!-- La fenêtre est aussi un enfant, elle voit 'vm' sans problème -->
        <window
            title=""
            border="none"
            width="560px"
            closable="false"
            sizable="false"
            mode="modal"
            position="center"
            style="background:#FFFFFF;border-radius:14px;box-shadow:0 14px 44px rgba(0,0,0,.12)">
            
            <vbox hflex="1" spacing="22px" align="center" style="padding:28px 56px">
                <image src="/img/logo-gedi.png" width="72px" height="72px"/>
                <label value="GEDI" style="font-size:30px;font-weight:700;color:#005A9E"/>
                <label value="Bienvenue dans votre espace GEDI" style="color:#6b7280"/>

                <!-- Les boutons sont dans la fenêtre, ils voient aussi 'vm' -->
                <vbox spacing="14px" hflex="1" style="width:100%">
                    <button label="Documents" hflex="1"
                            iconSclass="z-icon-folder-o"
                            onClick="@command('goDocs')"
                            style="height:48px;background:#1976D2;color:#fff;border:none;border-radius:8px"/>

                    <button label="Bibliothèque" hflex="1"
                            iconSclass="z-icon-book"
                            onClick="@command('goBiblio')"
                            style="height:48px;background:#2E7D32;color:#fff;border:none;border-radius:8px"/>

                    <button label="Administration" hflex="1"
                            iconSclass="z-icon-cog"
                            visible="@load(vm.adminVisible)"
                            onClick="@command('goAdmin')"
                            style="height:48px;background:#7B1FA2;color:#fff;border:none;border-radius:8px"/>

                    <button label="Déconnexion" hflex="1"
                            iconSclass="z-icon-sign-out"
                            onClick="@command('logout')"
                            style="height:48px;background:#f44336;color:#fff;border:none;border-radius:8px"/>
                </vbox>

                <hlayout spacing="12px">
                    <a label="Aide" href="#"/>
                    <label value="·"/>
                    <a label="Paramètres" href="#"/>
                    <label value="·"/>
                    <a label="À propos" href="#"/>
                </hlayout>
            </vbox>
        </window>
    </div>
</zk>