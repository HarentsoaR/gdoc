<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.FiliereViewModel')">
        
        <vlayout hflex="1" vflex="1" sclass="z-flex z-flex-col" style="gap: 16px;">

            <!-- En-tête de page -->
            <div sclass="page-header">
                <div>
                    <label value="Liste des Filières" sclass="page-title"/>
                    <label value="Gérer les filières de formation" sclass="page-subtitle"/>
                </div>
                <div sclass="header-actions">
                    <button label="Nouvelle Filière" sclass="enmg-btn enmg-btn-primary" iconSclass="z-icon-plus" onClick="@command('addFiliere')"/>
                </div>
            </div>

            <!-- Barre de filtres -->
            <div sclass="filter-bar">
                <div sclass="search-box" hflex="1">
                    <n:i class="z-icon-search search-icon" />
                    <textbox hflex="1" placeholder="Rechercher par code ou libellé..." value="@bind(vm.searchQuery)" onOK="@command('search')" instant="true"/>
                </div>
                <button label="Rafraîchir" sclass="enmg-btn enmg-btn-secondary" iconSclass="z-icon-refresh" onClick="@command('search')"/>
            </div>

            <!-- Panneau du tableau -->
            <div class="panel enmg-card" vflex="1">
                <listbox model="@load(vm.filiereList)" emptyMessage="Aucune filière trouvée." mold="paging" pageSize="10" vflex="1" sclass="data-table">
                    <listhead>
                        <listheader label="Code" width="200px" sort="auto(code)"/>
                        <listheader label="Libellé" sort="auto(libelle)"/>
                        <listheader label="Type" width="200px" sort="auto(sysId)"/>
                        <listheader label="Actions" width="120px" align="center"/>
                    </listhead>
                    <template name="model" var="f">
                        <listitem sclass="data-table-row">
                            <listcell label="@load(f.code)"/>
                            <listcell label="@load(f.libelle)"/>
                            <listcell label="@load(f.sysId)"/>
                            <listcell sclass="actions-cell">
                                <div hflex="1" align="center" style="display: flex; gap: 16px; justify-content: center;">
                                    <a iconSclass="z-icon-pencil" tooltiptext="Modifier" onClick="@command('edit', filiereToEdit=f)"/>
                                    <a iconSclass="z-icon-trash" tooltiptext="Supprimer" sclass="text-danger" onClick="@command('deleteFiliere', id=f.filiereId)"/>
                                </div>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>

        </vlayout>
    </div>
</zk>
