<zk xmlns="http://www.zkoss.org/2005/zul">
    <style>
        .candidat-form-container {
            max-width: 1200px;
            overflow-y: auto;
            max-height: 80vh;
            padding: 16px;
        }

        .candidat-form-grid {
            width: 100%;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .candidat-form-container {
                padding: 8px;
                max-width: 100%;
            }

            .candidat-form-grid .z-row .z-cell {
                display: block !important;
                width: 100% !important;
                margin-bottom: 8px;
            }
        }
    </style>

    <div hflex="1" vflex="1" sclass="content-area">

        <!-- Header -->
        <div sclass="content-header">
            <div>
                <label value="Nouveau Candidat" sclass="page-title"/>
                <label value="Ajouter un nouveau candidat au système" sclass="text-muted"
                       style="display: block; margin-top: 4px;"/>
            </div>
            <div sclass="header-actions">
                <button label="Annuler" sclass="btn-secondary" iconSclass="z-icon-times"
                        onClick="@command('cancelCandidat')"/>
                <button label="Sauvegarder" sclass="btn-primary" iconSclass="z-icon-save"
                        onClick="@command('saveCandidat')"/>
            </div>
        </div>

        <!-- Formulaire -->
        <div class="candidat-form-container">
            <grid class="candidat-form-grid">
                <columns>
                    <column width="200px"/>
                    <column/>
                    <column width="200px"/>
                    <column/>
                </columns>
                <rows>

                    <!-- Informations personnelles -->
                    <row>
                        <cell colspan="4" sclass="fw-bold"
                              style="padding: 16px 0 8px 0; border-bottom: 1px solid var(--border-color);">
                            <label value="Informations Personnelles"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Numéro d’inscription *" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.numInscription)"
                                     placeholder="INS-XXXXXX" width="100%"
                                     constraint="no empty: Le numéro d’inscription est obligatoire"/>
                        </cell>
                        <cell><label value="Numéro d’enregistrement *" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.numeroEnregistrement)"
                                     placeholder="Numéro d’enregistrement" width="100%"
                                     constraint="no empty: Le numéro d’enregistrement est obligatoire"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Nom *" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.nom)"
                                     placeholder="Nom de famille" width="100%"
                                     constraint="no empty: Le nom est obligatoire"/>
                        </cell>
                        <cell><label value="Prénom" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.prenom)"
                                     placeholder="Prénom" width="100%"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Sexe *" sclass="fw-bold"/></cell>
                        <cell>
                            <!-- ****** THIS IS THE FIX ****** -->
                            <!-- Values are now numbers to match your Integer property in Java -->
                            <radiogroup selectedItem="@bind(vm.candidatViewModel.currentCandidat.sexe)">
                                <radio label="Masculin" value="1"/>
                                <radio label="Féminin" value="2"/>
                            </radiogroup>
                        </cell>
                        <cell><label value="Date de naissance *" sclass="fw-bold"/></cell>
                        <cell>
                            <datebox value="@bind(vm.candidatViewModel.currentCandidat.dateNaissance)"
                                     width="100%" format="dd/MM/yyyy"
                                     constraint="no empty: La date de naissance est obligatoire"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Lieu de naissance *" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.lieuNaissance)"
                                     placeholder="Lieu de naissance" width="100%"
                                     constraint="no empty: Le lieu de naissance est obligatoire"/>
                        </cell>
                        <cell><label value="Téléphone" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.contactTelephonique)"
                                     placeholder="Numéro de téléphone" width="100%"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Adresse *" sclass="fw-bold"/></cell>
                        <cell colspan="3">
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.adresseEleve)"
                                     placeholder="Adresse complète" width="100%"
                                     constraint="no empty: L'adresse est obligatoire"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Email" sclass="fw-bold"/></cell>
                        <cell colspan="3">
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.mail)"
                                     placeholder="adresse@email.com" width="100%"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Situation matrimoniale" sclass="fw-bold"/></cell>
                        <cell>
                            <combobox value="@bind(vm.candidatViewModel.currentCandidat.situationMatrimoniale)"
                                      autodrop="true" width="100%">
                                <comboitem label="Célibataire" value="CELIBATAIRE"/>
                                <comboitem label="Marié(e)" value="MARIE"/>
                                <comboitem label="Divorcé(e)" value="DIVORCE"/>
                                <comboitem label="Veuf(ve)" value="VEUF"/>
                            </combobox>
                        </cell>
                        <cell><label value="Nombre d’enfants" sclass="fw-bold"/></cell>
                        <cell>
                            <intbox value="@bind(vm.candidatViewModel.currentCandidat.nombreEnfant)" width="100%"/>
                        </cell>
                    </row>

                    <!-- Parents -->
                    <row>
                        <cell><label value="Nom du père" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.nomPere)" width="100%"/>
                        </cell>
                        <cell><label value="Profession du père" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.professionPere)" width="100%"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Nom de la mère" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.nomMere)" width="100%"/>
                        </cell>
                        <cell><label value="Profession de la mère" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.professionMere)" width="100%"/>
                        </cell>
                    </row>

                    <!-- Personne à prévenir -->
                    <row>
                        <cell><label value="Personne à prévenir" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.personneAPrevenir)"
                                     width="100%"/>
                        </cell>
                        <cell><label value="Tel personne à prévenir" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.telPersonneAPrevenir)"
                                     width="100%"/>
                        </cell>
                    </row>

                    <!-- Informations concours -->
                    <row>
                        <cell colspan="4" sclass="fw-bold"
                              style="padding: 24px 0 8px 0; border-bottom: 1px solid var(--border-color);">
                            <label value="Informations Concours"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Concours *" sclass="fw-bold"/></cell>
                        <cell>
                            <combobox model="@load(vm.candidatViewModel.concoursList)"
                                      selectedItem="@bind(vm.candidatViewModel.currentCandidat.concours)"
                                      autodrop="true" width="100%"
                                      constraint="no empty: Le concours est obligatoire">
                                <template name="model" var="concours">
                                    <comboitem label="@load(concours.toString())"/>
                                </template>
                            </combobox>
                        </cell>

                        <cell><label value="Centre d'examen *" sclass="fw-bold"/></cell>
                        <cell>
                            <combobox model="@load(vm.candidatViewModel.centreExamenList)"
                                      selectedItem="@bind(vm.candidatViewModel.currentCandidat.centreExamen)"
                                      autodrop="true" width="100%"
                                      constraint="no empty: Le centre d'examen est obligatoire">
                                <template name="model" var="centre">
                                    <comboitem label="@load(centre.libelle)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Rang concours" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.rangConcours)" width="100%"/>
                        </cell>
                        <cell><label value="Date de dépôt" sclass="fw-bold"/></cell>
                        <cell>
                            <datebox value="@bind(vm.candidatViewModel.currentCandidat.dateDepotCandidature)"
                                     width="100%" format="dd/MM/yyyy"/>
                        </cell>
                    </row>

                    <!-- Informations professionnelles -->
                    <row>
                        <cell colspan="4" sclass="fw-bold"
                              style="padding: 24px 0 8px 0; border-bottom: 1px solid var(--border-color);">
                            <label value="Informations Professionnelles (Optionnel)"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Statut fonctionnaire" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.statutFonctionnaire)"
                                     width="100%"/>
                        </cell>
                        <cell><label value="IM Fonctionnaire" sclass="fw-bold"/></cell>
                        <cell>
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.imFonctionnaire)"
                                     width="100%"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Dernière fonction" sclass="fw-bold"/></cell>
                        <cell colspan="3">
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.derniereFonction)"
                                     width="100%"/>
                        </cell>
                    </row>

                    <row>
                        <cell><label value="Remarques" sclass="fw-bold"/></cell>
                        <cell colspan="3">
                            <textbox value="@bind(vm.candidatViewModel.currentCandidat.remarque)"
                                     width="100%" rows="3"/>
                        </cell>
                    </row>

                </rows>
            </grid>
        </div>
    </div>
</zk>