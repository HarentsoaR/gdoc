<!-- File Path: src/main/webapp/documents/views/candidats/dossiers.zul -->
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    
    <!-- NO MORE INLINE STYLE! -->

    <div hflex="1" vflex="1" sclass="page-container" 
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.ListeDossierConcoursCandidatViewModel')">
        
        <!-- Main page layout using vlayout for flexibility -->
        <vlayout hflex="1" vflex="1" sclass="z-flex z-flex-col" style="gap: 16px;">

            <!-- Header with Breadcrumbs and Actions -->
            <div sclass="page-header">
                <!-- Breadcrumbs -->
                <hlayout sclass="breadcrumb">
                    <forEach items="@load(vm.breadcrumbs)" var="crumb" varStatus="status">
                        <a label="@load(crumb.label)" sclass="breadcrumb-link"
                           onClick="@command('navigateViaBreadcrumb', crumb=crumb)"
                           if="${!status.last}"/>
                        <label value="@load(crumb.label)" sclass="breadcrumb-current" if="${status.last}"/>
                        <label value="›" sclass="breadcrumb-separator" if="${!status.last}"/>
                    </forEach>
                </hlayout>

                <!-- Actions -->
                <button label="Rafraîchir" sclass="btn" iconSclass="z-icon-refresh" onClick="@command('applyFilters')"/>
            </div>

            <!-- Advanced Filter Bar (Conditional) -->
            <div sclass="panel-filters" visible="@load(vm.selectedDocumentType ne null)">
                <!-- Filters -->
                <hlayout hflex="1" spacing="16px">
                    <vlayout hflex="1">
                        <label value="Concours"/>
                        <combobox model="@load(vm.allConcours)" selectedItem="@bind(vm.selectedConcoursFilter)"
                                  hflex="1" placeholder="Tous les concours" autodrop="true" readonly="true"/>
                    </vlayout>
                    <vlayout hflex="1">
                        <label value="Centre d'examen"/>
                        <combobox model="@load(vm.allCentresExamen)" selectedItem="@bind(vm.selectedCentreExamenFilter)"
                                  hflex="1" placeholder="Tous les centres" autodrop="true" readonly="true"/>
                    </vlayout>
                    <vlayout hflex="1">
                        <label value="Nom du candidat"/>
                        <textbox value="@bind(vm.filterNomCandidat)" hflex="1" placeholder="Rechercher..."
                                 instant="true" onOK="@command('applyFilters')"/>
                    </vlayout>
                    <hlayout hflex="min" spacing="8px" style="padding-bottom: 2px;">
                        <button label="Rechercher" sclass="btn-primary" iconSclass="z-icon-search" onClick="@command('applyFilters')"/>
                        <button label="Effacer" sclass="btn" iconSclass="z-icon-eraser" onClick="@command('clearFilters')"/>
                    </hlayout>
                </hlayout>

                <!-- Active Filter Pills -->
                <hlayout valign="middle" spacing="8px" style="margin-top: 12px;"
                         visible="@load(vm.selectedConcoursFilter ne null or vm.selectedCentreExamenFilter ne null or not empty vm.filterNomCandidat)">
                    <label value="Filtres actifs :" style="font-size: 13px; color: var(--text-muted);"/>
                    <div sclass="filter-pill" visible="@load(vm.selectedConcoursFilter ne null)">
                        <label value="@load(vm.selectedConcoursFilter.toString())"/>
                    </div>
                    <div sclass="filter-pill" visible="@load(vm.selectedCentreExamenFilter ne null)">
                        <label value="@load(vm.selectedCentreExamenFilter.libelle)"/>
                    </div>
                    <div sclass="filter-pill" visible="@load(not empty vm.filterNomCandidat)">
                        <label value="@load(vm.filterNomCandidat)"/>
                    </div>
                </hlayout>
            </div>

            <!-- Main Content Panel (vflex=1 to take all remaining space) -->
            <div class="panel" vflex="1">
                <listbox model="@load(vm.displayItems)" vflex="1" hflex="1" 
                         emptyMessage="Aucun élément à afficher. Essayez de sélectionner un type de document ou de modifier vos filtres."
                         mold="paging" pageSize="15">
                    <listhead>
                        <listheader label="Nom" />
                        <listheader label="Propriétaire" visible="@load(vm.selectedDocumentType ne null)" />
                        <listheader label="État" visible="@load(vm.selectedDocumentType ne null)" width="150px"/>
                        <listheader label="Actions" width="120px" align="center"/>
                    </listhead>
                    <template name="model" var="d">
                        <listitem onDoubleClick="@command(d.folder ? 'navigate' : 'download', item=d)" sclass="explorer-item">
                            <!-- Cell: Name (Folder or File) -->
                            <listcell>
                                <hlayout spacing="12px" valign="center">
                                    <n:i class="${d.iconSclass} explorer-item-icon"/>
                                    <vlayout>
                                        <label value="@load(d.name)" sclass="explorer-item-title"/>
                                        <label value="@load(d.subtitle)" sclass="explorer-item-subtitle" visible="@load(not empty d.subtitle)"/>
                                    </vlayout>
                                </hlayout>
                            </listcell>

                            <!-- Cells visible only for files -->
                            <listcell label="@load(d.folder ? '' : d.data.candidat.nom.concat(' ').concat(d.data.candidat.prenom))"/>
                            <listcell label="@load(d.folder ? '' : d.data.etatDoc)"/>
                            
                            <!-- Cell: Actions -->
                            <listcell sclass="actions-cell">
                                <div hflex="1" if="${!d.folder}">
                                    <a iconSclass="z-icon-download" tooltiptext="Télécharger"
                                            onClick="@command('download', item=d)"/>
                                </div>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
        </vlayout>
    </div>
</zk>