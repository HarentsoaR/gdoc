<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <div sclass="page-container" vflex="1"
         viewModel="@id('dvm') @init('mg.md2i.gedi.control.viewmodel.ListeDossierConcoursCandidatViewModel')">
        <vlayout hflex="1" vflex="1" style="gap:16px;">
            <div class="page-header">
                <hlayout sclass="breadcrumb">
                    <forEach items="@load(dvm.breadcrumbs)" var="crumb" varStatus="status">
                        <a label="@load(crumb.label)" sclass="breadcrumb-link"
                           onClick="@command('navigateViaBreadcrumb', crumb=crumb)"
                           if="${!status.last}"/>
                        <label value="@load(crumb.label)" sclass="breadcrumb-current" if="${status.last}"/>
                        <label value="›" sclass="breadcrumb-separator" if="${!status.last}"/>
                    </forEach>
                </hlayout>
                <div class="header-actions">
                    <button label="@load(dvm.filtersVisible ? 'Masquer les filtres' : 'Afficher les filtres')"
                            sclass="btn"
                            iconSclass="@load(dvm.filtersVisible ? 'z-icon-chevron-up' : 'z-icon-chevron-down')"
                            onClick="@command('toggleFilters')"/>
                    <button label="Rafraîchir" sclass="btn" iconSclass="z-icon-refresh"
                            onClick="@command('applyFilters')"/>
                </div>
            </div>

            <div class="panel filter-stack" visible="@load(dvm.filtersVisible and dvm.selectedDocumentType ne null)">
                <vlayout hflex="1" style="gap:12px;">
                    <hlayout hflex="1" spacing="12px">
                        <div sclass="filter-pill flex-pill">
                            <label value="Concours" sclass="filter-label"/>
                            <combobox model="@load(dvm.allConcours)" selectedItem="@bind(dvm.selectedConcoursFilter)"
                                      autodrop="true" placeholder="Tous les concours" readonly="true" hflex="1"/>
                        </div>
                        <div sclass="filter-pill flex-pill">
                            <label value="Centre" sclass="filter-label"/>
                            <combobox model="@load(dvm.allCentresExamen)" selectedItem="@bind(dvm.selectedCentreExamenFilter)"
                                      autodrop="true" placeholder="Tous les centres" readonly="true" hflex="1"/>
                        </div>
                        <div sclass="filter-pill flex-pill">
                            <label value="Nom du candidat" sclass="filter-label"/>
                            <textbox value="@bind(dvm.filterNomCandidat)" placeholder="Rechercher..."
                                     instant="true" hflex="1" onOK="@command('applyFilters')"/>
                        </div>
                        <hlayout spacing="8px">
                            <button label="Rechercher" sclass="btn btn-primary" iconSclass="z-icon-search"
                                    onClick="@command('applyFilters')"/>
                            <button label="Effacer" sclass="btn" iconSclass="z-icon-eraser"
                                    onClick="@command('clearFilters')"/>
                        </hlayout>
                    </hlayout>
                    <hlayout sclass="active-filters" visible="@load(dvm.anyFilterActive)">
                        <label value="Filtres actifs :" class="text-muted"/>
                        <div sclass="filter-pill" visible="@load(dvm.selectedConcoursFilter ne null)">
                            <label value="@load(dvm.selectedConcoursFilter.toString())"/>
                            <button iconSclass="z-icon-times" onClick="@command('removeFilter', type='concours')"/>
                        </div>
                        <div sclass="filter-pill" visible="@load(dvm.selectedCentreExamenFilter ne null)">
                            <label value="@load(dvm.selectedCentreExamenFilter.libelle)"/>
                            <button iconSclass="z-icon-times" onClick="@command('removeFilter', type='centre')"/>
                        </div>
                        <div sclass="filter-pill" visible="@load(not empty dvm.filterNomCandidat)">
                            <label value="@load(dvm.filterNomCandidat)"/>
                            <button iconSclass="z-icon-times" onClick="@command('removeFilter', type='nom')"/>
                        </div>
                    </hlayout>
                </vlayout>
            </div>

            <div class="panel" vflex="1">
                <listbox model="@load(dvm.displayItems)" vflex="1" hflex="1"
                         sizedByContent="false" sclass="listbox-thread data-table"
                         emptyMessage="Aucun document à afficher.">
                    <listhead>
                        <listheader label="Document" hflex="2"/>
                        <listheader label="Candidat" hflex="1"/>
                        <listheader label="Statut" width="140px" visible="@load(dvm.selectedDocumentType ne null)"/>
                        <listheader label="Actions" width="140px"/>
                    </listhead>
                    <template name="model" var="row">
                        <listitem onDoubleClick="@command('openItem', item=row)">
                            <listcell>
                                <hlayout spacing="12px" valign="center">
                                    <n:i sclass="@load(row.iconSclass)" class="explorer-item-icon"/>
                                    <vlayout style="gap:2px;">
                                        <label value="@load(row.name)" sclass="explorer-item-title"/>
                                        <label value="@load(row.subtitle)" sclass="explorer-item-subtitle"
                                               visible="@load(not empty row.subtitle)"/>
                                    </vlayout>
                                </hlayout>
                            </listcell>
                            <listcell>
                                <label value="@load(dvm.getCandidatLabel(row))" sclass="text-muted"/>
                            </listcell>
                            <listcell visible="@load(dvm.selectedDocumentType ne null)">
                                <label value="@load(dvm.getEtatLabel(row))"
                                       sclass="@load(dvm.getEtatSclass(row))"
                                       visible="@load(not row.folder)"/>
                            </listcell>
                            <listcell>
                                <hlayout spacing="10px">
                                    <a iconSclass="z-icon-folder-open" tooltiptext="Ouvrir"
                                       visible="@load(row.folder)"
                                       onClick="@command('navigate', item=row)"/>
                                    <a iconSclass="z-icon-download" tooltiptext="Télécharger"
                                       visible="@load(not row.folder)"
                                       onClick="@command('download', item=row)"/>
                                    <a iconSclass="z-icon-trash-o" sclass="text-danger"
                                       tooltiptext="Supprimer"
                                       visible="@load(not row.folder)"
                                       onClick="@command('delete', item=row)"/>
                                </hlayout>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
        </vlayout>
    </div>
</zk>