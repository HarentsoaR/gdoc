<zk>
    <style>
        .candidat-form-container { max-width: 1200px; overflow-y: auto; max-height: 80vh; padding: 16px; }
        .candidat-form-grid { width: 100%; }
    </style>
    
    <div hflex="1" vflex="1" sclass="content-area"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.CandidatViewModel', candidatToManage=arg.candidatToManage)">

        <div sclass="content-header">
            <div>
                <label value="Modifier Candidat" sclass="page-title"/>
                <label value="Modifier les informations du candidat" sclass="text-muted" style="display: block; margin-top: 4px;"/>
            </div>
            <div sclass="header-actions">
                <button label="Annuler" sclass="btn-secondary" iconSclass="z-icon-times" onClick="@command('cancelCandidat')"/>
                <button label="Sauvegarder" sclass="btn-primary" iconSclass="z-icon-save" onClick="@command('saveCandidat')"/>
            </div>
        </div>

        <div class="candidat-form-container">
            <grid class="candidat-form-grid">
                <columns>
                    <column width="200px"/><column/><column width="200px"/><column/>
                </columns>
                <rows>
                    <row><cell colspan="4" sclass="fw-bold" style="padding: 16px 0 8px 0; border-bottom: 1px solid var(--border-color);"><label value="Informations Personnelles"/></cell></row>
                    <row>
                        <cell><label value="Numéro d’inscription *" sclass="fw-bold"/></cell>
                        <cell><textbox value="@bind(vm.currentCandidat.numInscription)" width="100%" constraint="no empty"/></cell>
                        <cell><label value="Numéro d’enregistrement *" sclass="fw-bold"/></cell>
                        <cell><textbox value="@bind(vm.currentCandidat.numeroEnregistrement)" width="100%" constraint="no empty"/></cell>
                    </row>
                    <row>
                        <cell><label value="Nom *" sclass="fw-bold"/></cell>
                        <cell><textbox value="@bind(vm.currentCandidat.nom)" width="100%" constraint="no empty"/></cell>
                        <cell><label value="Prénom" sclass="fw-bold"/></cell>
                        <cell><textbox value="@bind(vm.currentCandidat.prenom)" width="100%"/></cell>
                    </row>
                    <row>
                        <cell><label value="Sexe *" sclass="fw-bold"/></cell>
                        <cell><radiogroup selectedItem="@bind(vm.currentCandidat.sexe)"><radio label="Masculin" value="1"/><radio label="Féminin" value="2"/></radiogroup></cell>
                        <cell><label value="Date de naissance *" sclass="fw-bold"/></cell>
                        <cell><datebox value="@bind(vm.currentCandidat.dateNaissance)" width="100%" format="dd/MM/yyyy" constraint="no empty"/></cell>
                    </row>
                    <row>
                        <cell><label value="Lieu de naissance *" sclass="fw-bold"/></cell>
                        <cell><textbox value="@bind(vm.currentCandidat.lieuNaissance)" width="100%" constraint="no empty"/></cell>
                        <cell><label value="Téléphone" sclass="fw-bold"/></cell>
                        <cell><textbox value="@bind(vm.currentCandidat.contactTelephonique)" width="100%"/></cell>
                    </row>
                    <row>
                        <cell><label value="Adresse *" sclass="fw-bold"/></cell>
                        <cell colspan="3"><textbox value="@bind(vm.currentCandidat.adresseEleve)" width="100%" constraint="no empty"/></cell>
                    </row>
                    <row>
                        <cell><label value="Email" sclass="fw-bold"/></cell>
                        <cell colspan="3"><textbox value="@bind(vm.currentCandidat.mail)" width="100%"/></cell>
                    </row>
                    <row>
                        <cell><label value="Situation matrimoniale" sclass="fw-bold"/></cell>
                        <cell><combobox value="@bind(vm.currentCandidat.situationMatrimoniale)" autodrop="true" width="100%"><comboitem label="Célibataire"/><comboitem label="Marié(e)"/><comboitem label="Divorcé(e)"/><comboitem label="Veuf(ve)"/></combobox></cell>
                        <cell><label value="Nombre d’enfants" sclass="fw-bold"/></cell>
                        <cell><intbox value="@bind(vm.currentCandidat.nombreEnfant)" width="100%"/></cell>
                    </row>
                    <row><cell><label value="Nom du père" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.nomPere)" width="100%"/></cell><cell><label value="Profession du père" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.professionPere)" width="100%"/></cell></row>
                    <row><cell><label value="Nom de la mère" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.nomMere)" width="100%"/></cell><cell><label value="Profession de la mère" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.professionMere)" width="100%"/></cell></row>
                    <row><cell><label value="Personne à prévenir" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.personneAPrevenir)" width="100%"/></cell><cell><label value="Tel personne à prévenir" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.telPersonneAPrevenir)" width="100%"/></cell></row>
                    <row><cell colspan="4" sclass="fw-bold" style="padding: 24px 0 8px 0; border-bottom: 1px solid var(--border-color);"><label value="Informations Concours"/></cell></row>
                    <row>
                        <cell><label value="Concours *" sclass="fw-bold"/></cell>
                        <cell><combobox model="@load(vm.concoursList)" selectedItem="@bind(vm.currentCandidat.concours)" autodrop="true" width="100%" constraint="no empty"><template name="model"><comboitem label="@load(each.avisConcours)"/></template></combobox></cell>
                        <cell><label value="Centre d'examen *" sclass="fw-bold"/></cell>
                        <cell><combobox model="@load(vm.centreExamenList)" selectedItem="@bind(vm.currentCandidat.centreExamen)" autodrop="true" width="100%" constraint="no empty"><template name="model"><comboitem label="@load(each.libelle)"/></template></combobox></cell>
                    </row>
                    <row>
                        <cell><label value="Rang concours" sclass="fw-bold"/></cell>
                        <cell><textbox value="@bind(vm.currentCandidat.rangConcours)" width="100%"/></cell>
                        <cell><label value="Date de dépôt" sclass="fw-bold"/></cell>
                        <cell><datebox value="@bind(vm.currentCandidat.dateDepotCandidature)" width="100%" format="dd/MM/yyyy"/></cell>
                    </row>
                    <row><cell colspan="4" sclass="fw-bold" style="padding: 24px 0 8px 0; border-bottom: 1px solid var(--border-color);"><label value="Informations Professionnelles (Optionnel)"/></cell></row>
                    <row><cell><label value="Statut fonctionnaire" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.statutFonctionnaire)" width="100%"/></cell><cell><label value="IM Fonctionnaire" sclass="fw-bold"/></cell><cell><textbox value="@bind(vm.currentCandidat.imFonctionnaire)" width="100%"/></cell></row>
                    <row><cell><label value="Dernière fonction" sclass="fw-bold"/></cell><cell colspan="3"><textbox value="@bind(vm.currentCandidat.derniereFonction)" width="100%"/></cell></row>
                    <row><cell><label value="Remarques" sclass="fw-bold"/></cell><cell colspan="3"><textbox value="@bind(vm.currentCandidat.remarque)" width="100%" rows="3"/></cell></row>
                </rows>
            </grid>
        </div>
    </div>
</zk>