<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">

    <div hflex="1" vflex="1" sclass="page-container">
        
        <vlayout hflex="1" vflex="1" sclass="z-flex z-flex-col" style="gap: 16px;">

            <!-- En-tête de la page -->
            <div sclass="page-header">
                <div>
                    <label value="@load(vm.searchResultsHeadline)" sclass="page-title"/>
                    <label value="@load(vm.searchResultsHint)" sclass="page-subtitle"/>
                </div>
            </div>

            <!--<div class="panel search-summary-panel">
                <vlayout hflex="1" style="gap: 6px;">
                    <label value="Astuce : combinez les mots-clés" sclass="search-tip-title"/>
                    <label value='Exemple : concours:"formation continue" centre:Antananarivo document:"acte de naissance"'
                           sclass="search-tip"/>
                    <label value="Filtres textuels disponibles : concours:, filiere:, promotion:, centre:, etat:, numero:, inscription:"
                           sclass="search-tip"/>
                </vlayout>
            </div>-->
            
            <div class="panel scroll-panel" vflex="1">
                <listbox model="@load(vm.searchResults)" vflex="1" hflex="1"
                         emptyMessage="Affinez votre requête pour afficher des résultats."
                         mold="paging" pageSize="9"
                         sclass="search-result-list">
                    <template name="model" var="result">
                        <listitem>
                            <listcell hflex="1">
                                <vlayout sclass="search-result-card">
                                    <hlayout valign="center" hflex="1" sclass="search-result-head">
                                        <a label="@load(result.docTypeName)" sclass="search-result-title"
                                           onClick="@command('openSearchResult', result=result)"/>
                                        <label value="@load(result.etatLabel)" sclass="@load('status-label '.concat(result.etatSclass))"/>
                                    </hlayout>
                                    <label value="@load(result.candidateFullName)" sclass="search-result-subtitle"/>
                                    <label value="@load(result.concoursDisplayInfo)" sclass="search-result-meta"/>
                                    <label value="@load(result.metaLine)" sclass="search-result-meta"
                                           visible="@load(not empty result.metaLine)"/>
                                    <label value="@load(result.dossierLine)" sclass="search-result-meta"
                                           visible="@load(not empty result.dossierLine)"/>
                                    <hlayout style="gap: 12px;">
                                        <button label="Ouvrir le dossier" sclass="pill-btn pill-btn--ghost btn-sm"
                                                iconSclass="z-icon-folder-open"
                                                onClick="@command('openSearchResult', result=result)"/>
                                        <a label="Télécharger la pièce" sclass="link-pill"
                                           visible="@load(result.hasAttachment())"
                                           href="@load(result.filePath)" target="_blank"/>
                                    </hlayout>
                                </vlayout>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>

        </vlayout>
    </div>
</zk>
