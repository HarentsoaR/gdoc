<zk xmlns:n="native">
    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('cv') @init('mg.md2i.gedi.control.viewmodel.ConcoursViewModel')">

        <!-- PAGE HEADER -->
        <div sclass="page-header">
            <div>
                <!--<label value="Liste des Concours" sclass="page-title"/>-->
                <label value="Gérer les concours existants" sclass="page-title"/>
            </div>
            <div sclass="header-actions">
                <button label="Nouveau Concours" sclass="btn-primary" iconSclass="z-icon-plus"
                        onClick="@command('addConcours')"/>
            </div>
        </div>

        <!-- FILTER BAR -->
        <div sclass="filter-bar" style="margin-top: 24px;">
            <!-- Search box with an embedded icon -->
            <div sclass="search-box" hflex="1">
                <n:i class="z-icon-search search-icon" />
                <textbox placeholder="Rechercher par avis, arrêté, promotion..."
                         value="@bind(cv.searchQuery)"
                         onOK="@command('search')"
                         instant="true" />
            </div>
            <button label="Rafraîchir" sclass="btn" iconSclass="z-icon-refresh" 
                    onClick="@command('refreshConcoursList')"/>
        </div>

        <!-- DATA TABLE -->
        <div class="panel" style="margin-top: 16px;">
            <listbox model="@load(cv.concoursList)" emptyMessage="Aucun concours trouvé." mold="paging" pageSize="6">
                <listhead>
                    <listheader label="Avis de Concours" sort="auto(avisConcours)"/>
                    <listheader label="N° Arrêté" sort="auto(numeroArrete)" width="150px"/>
                    <listheader label="Date Arrêté" sort="auto(dateArrete)" width="150px"/>
                    <listheader label="Promotion" sort="auto(promotion.libelle)"/>
                    <listheader label="Actions" width="100px" align="center"/>
                </listhead>
                <template name="model" var="concours">
                    <listitem>
                        <listcell label="@load(concours.avisConcours)"/>
                        <listcell label="@load(concours.numeroArrete)"/>
                        <listcell>
                            <label value="@load(concours.dateArrete) @converter('formatedDate', format='dd/MM/yyyy')"/>
                        </listcell>
                        <listcell label="@load(concours.promotion.libelle)"/>
                        <listcell sclass="actions-cell">
                            <div hflex="1" align="center" style="display: flex; gap: 16px; justify-content: center;">
                                <a iconSclass="z-icon-pencil" tooltiptext="Modifier"
                                   onClick="@command('edit', concours=concours)"/>
                                <a iconSclass="z-icon-trash" tooltiptext="Supprimer"
                                   onClick="@command('deleteConcours', id=concours.concoursId)"
                                   sclass="text-danger"/>
                            </div>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </div>
    </div>
</zk>