<?page title="Suivi des dossiers" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.DocumentSuiviViewModel')">

        <vlayout hflex="1" vflex="1" style="gap: 12px;">
            <div sclass="page-header">
                <div>
                    <label value="Suivi des dossiers" sclass="page-title"/>
                    <label value="Visualiser l'état d'avancement des documents" sclass="page-subtitle"/>
                </div>
                <div class="header-actions">
                    <button label="@load(vm.filtersVisible ? 'Masquer les filtres' : 'Afficher les filtres')"
                            sclass="btn"
                            iconSclass="@load(vm.filtersVisible ? 'z-icon-chevron-up' : 'z-icon-chevron-down')"
                            onClick="@command('toggleFilters')"/>
                    <button label="Réinitialiser" sclass="btn" iconSclass="z-icon-undo"
                            onClick="@command('clearFilters')"/>
                </div>
            </div>

            <div class="panel summary-inline">
                <div class="mini-card">
                    <label value="Total dossiers" class="mini-card-title"/>
                    <label value="@load(vm.summaryStats.total)" class="mini-card-value"/>
                    <label value="@load(vm.summaryStats.progressLabel)" class="mini-card-sub"/>
                    <div class="progress-shell mini">
                        <div class="progress-bar" style="@load(vm.summaryStats.progressStyle)"></div>
                    </div>
                </div>
                <div class="mini-card">
                    <label value="Validés" class="mini-card-title"/>
                    <label value="@load(vm.summaryStats.valides)" class="status-label status-success"/>
                </div>
                <div class="mini-card">
                    <label value="En cours" class="mini-card-title"/>
                    <label value="@load(vm.summaryStats.enCours)" class="status-label status-warning"/>
                </div>
                <div class="mini-card">
                    <label value="Rejetés" class="mini-card-title"/>
                    <label value="@load(vm.summaryStats.rejetes)" class="status-label status-danger"/>
                </div>
            </div>

            <div class="filter-stack panel" visible="@load(vm.filtersVisible)">
                <vlayout hflex="1" style="gap: 10px;">
                    <hlayout hflex="1" style="gap: 10px;">
                        <div sclass="filter-pill flex-pill">
                            <combobox model="@load(vm.concoursList)" selectedItem="@bind(vm.selectedConcours)"
                                      autodrop="true" placeholder="Tous les concours"
                                      sclass="pill-input"
                                      onSelect="@command('applyFilters')"/>
                    </div>
                    <div sclass="filter-pill flex-pill">
                        <combobox model="@load(vm.centreList)" selectedItem="@bind(vm.selectedCentre)"
                                  autodrop="true" placeholder="Tous les centres"
                                  sclass="pill-input"
                                  onSelect="@command('applyFilters')"/>
                    </div>
                    <div sclass="filter-pill flex-pill">
                        <combobox model="@load(vm.documentTypes)" selectedItem="@bind(vm.selectedDocumentType)"
                                  autodrop="true" placeholder="Tous les documents"
                                  sclass="pill-input"
                                  onSelect="@command('applyFilters')"/>
                    </div>
                        <div sclass="filter-pill flex-pill">
                            <combobox model="@load(vm.etatFilterOptions)" selectedItem="@bind(vm.selectedEtatFilter)"
                                      autodrop="true" placeholder="Tous les états"
                                      sclass="pill-input"
                                      onSelect="@command('applyFilters')"/>
                        </div>
                        <button label="Réinitialiser" sclass="btn btn-secondary pill-reset"
                                iconSclass="z-icon-undo"
                                onClick="@command('clearFilters')"/>
                    </hlayout>
                    <hlayout hflex="1" style="gap: 10px;">
                        <div sclass="filter-pill flex-pill">
                            <textbox value="@bind(vm.searchNomCandidat)" placeholder="Rechercher un candidat"
                                     onChanging="@command('updateSearchNom', keyword=event.value)"
                                     onOK="@command('applyFilters')" sclass="pill-input pill-input-search"/>
                        </div>
                    </hlayout>
                </vlayout>
            </div>

            <div class="panel scroll-panel" vflex="1">
                <label value="Double-cliquez sur un dossier pour consulter le détail" sclass="table-hint"/>
                <div sclass="table-scroll" vflex="1" hflex="1">
                    <listbox model="@load(vm.dossiers)" vflex="1" hflex="1" sizedByContent="false"
                             sclass="listbox-thread data-table" style="min-width: 1100px;"
                             emptyMessage="Aucun dossier trouvé pour ce suivi.">
                        <listhead sizable="true">
                            <listheader label="Dossier" hflex="3"/>
                            <listheader label="État dossier" width="160px"/>
                            <listheader label="Synthèse" hflex="2"/>
                            <listheader label="Pièces / Manque" hflex="2"/>
                        </listhead>
                        <template name="model" var="row">
                            <listitem onDoubleClick="@command('openDossier', row=row)">
                                <listcell>
                                    <vlayout sclass="listbox-thread-stack">
                                        <label value="@load(row.reference)" sclass="list-title text-ellipsis"/>
                                        <label value="@load(row.candidatLabel)" sclass="list-subtitle text-ellipsis"/>
                                        <label value="@load(row.concoursLabel)" sclass="list-meta text-ellipsis"/>
                                        <label value="@load(row.centreLabel)" sclass="list-meta text-ellipsis"/>
                                    </vlayout>
                                </listcell>
                                <listcell>
                                    <label value="@load(row.globalEtatLabel)" sclass="@load(row.globalEtatSclass)"/>
                                </listcell>
                                <listcell>
                                    <label value="@load(row.documentsResume)" sclass="text-muted"/>
                                </listcell>
                                <listcell>
                                    <label value="@load(row.piecesStateLabel)" sclass="@load(row.piecesStateSclass)"
                                           tooltiptext="@load(row.missingRequiredDetails)"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                </div>
            </div>
        </vlayout>
    </div>
</zk>
