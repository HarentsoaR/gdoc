<?page title="Validation des documents" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.DocumentValidationViewModel')">

        <vlayout hflex="1" vflex="1" style="gap: 12px;">
            <div sclass="page-header">
                <div>
                    <label value="@load(vm.detailTitle)" sclass="page-title"/>
                    <label value="@load(vm.detailSubtitle)" sclass="page-subtitle"/>
                </div>
                <div class="header-actions">
                    <button label="@load(vm.filtersVisible ? 'Masquer les filtres' : 'Afficher les filtres')"
                            sclass="btn"
                            iconSclass="@load(vm.filtersVisible ? 'z-icon-chevron-up' : 'z-icon-chevron-down')"
                            onClick="@command('toggleFilters')"/>
                    <button label="Télécharger le dossier" sclass="btn btn-primary"
                            iconSclass="z-icon-download"
                            visible="@load(vm.detailMode)"
                            onClick="@command('downloadFocusedDossier')"/>
                    <button label="Retour aux dossiers" sclass="btn"
                            iconSclass="z-icon-arrow-left"
                            onClick="@command('backToDossiers')"/>
                </div>
            </div>

            <div class="filter-stack panel" visible="@load(vm.filtersVisible)">
                <hlayout hflex="1" style="gap: 10px;">
                    <div sclass="filter-pill flex-pill">
                        <combobox model="@load(vm.documentTypes)" selectedItem="@bind(vm.selectedDocumentType)"
                                  autodrop="true" placeholder="Tous les documents"
                                  sclass="pill-input"
                                  onSelect="@command('applyFilters')"/>
                    </div>
                    <div sclass="filter-pill flex-pill">
                        <combobox model="@load(vm.etatFilterOptions)" selectedItem="@bind(vm.selectedEtatFilter)"
                                  autodrop="true" placeholder="Tous les états"
                                  sclass="pill-input"
                                  onSelect="@command('applyFilters')"/>
                    </div>
                    <button label="Réinitialiser" sclass="btn btn-secondary pill-reset"
                            iconSclass="z-icon-undo"
                            onClick="@command('clearFilters')"/>
                </hlayout>
            </div>

            <div class="selection-toolbar selection-toolbar--compact">
                <label value="@load(vm.documentSelectionLabel)" sclass="selection-count"/>
                <div class="selection-actions">
                    <button label="@load(vm.documentToggleLabel)" sclass="pill-btn pill-btn--ghost btn-sm"
                            disabled="@load(empty vm.dossiers)"
                            onClick="@command('toggleDocumentSelection')"/>
                    <button label="Télécharger" sclass="pill-btn pill-btn--ghost btn-sm"
                            iconSclass="z-icon-download"
                            disabled="@load(empty vm.selectedRows)"
                            onClick="@command('downloadDocumentSelection')"/>
                    <button label="Valider" sclass="pill-btn pill-btn--primary btn-sm"
                            visible="@load(vm.canValidate)"
                            disabled="@load(empty vm.selectedRows or not vm.canValidate)"
                            onClick="@command('bulkChangeEtat', etat=1)"/>
                    <button label="Rejeter" sclass="pill-btn pill-btn--danger btn-sm"
                            visible="@load(vm.canValidate)"
                            disabled="@load(empty vm.selectedRows or not vm.canValidate)"
                            onClick="@command('bulkChangeEtat', etat=0)"/>
                    <button label="Revoir" sclass="pill-btn pill-btn--ghost btn-sm"
                            visible="@load(vm.canValidate)"
                            disabled="@load(empty vm.selectedRows or not vm.canValidate)"
                            onClick="@command('bulkChangeEtat', etat=2)"/>
                </div>
            </div>

            <div class="panel scroll-panel" vflex="1">
                <listbox model="@load(vm.dossiers)" vflex="1" hflex="1" sizedByContent="true"
                         checkmark="true" multiple="true" selectedItems="@bind(vm.selectedRows)"
                         onCheckSelect="@command('updateSelection')"
                         sclass="listbox-thread data-table"
                         emptyMessage="Aucun document à valider.">
                    <listhead>
                        <listheader label="Document" hflex="2"/>
                        <listheader label="Centre" width="200px"/>
                        <listheader label="Statut" width="140px"/>
                        <listheader label="Remarques" hflex="2"/>
                    </listhead>
                    <template name="model" var="item">
                        <listitem>
                            <listcell>
                                <vlayout sclass="listbox-thread-stack">
                                    <label value="@load(item.documentLabel)" sclass="list-title text-ellipsis"/>
                                    <hlayout spacing="6px" sclass="document-meta">
                                        <label value="@load(item.candidatLabel)" sclass="text-ellipsis"/>
                                        <label value="•" sclass="separator-bullet"/>
                                        <label value="@load(item.concoursLabel)" sclass="text-muted text-ellipsis"/>
                                    </hlayout>
                                    <a onClick="@command('download', item=item)"
                                       visible="@load(item.hasAttachment)"
                                       sclass="link-pill">
                                        Télécharger la pièce
                                    </a>
                                    <label value="Pièce manquante"
                                           sclass="status-label status-danger"
                                           visible="@load(not item.hasAttachment)"/>
                                </vlayout>
                            </listcell>
                            <listcell>
                                <label value="@load(item.centreLabel)" sclass="text-ellipsis"/>
                            </listcell>
                            <listcell>
                                <label value="@load(item.etatLabel)" sclass="@load('status-label '.concat(item.etatSclass))"/>
                            </listcell>
                            <listcell>
                                <textbox value="@bind(item.commentaire)" hflex="1" rows="1"
                                         maxlength="255" placeholder="Ajouter une remarque"
                                         sclass="validation-remark"/>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
        </vlayout>
    </div>
</zk>
