<?page title="Validation des dossiers" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.DocumentValidationViewModel')">

        <vlayout hflex="1" vflex="1" style="gap: 12px;">
            <div sclass="page-header">
                <div>
                    <label value="Validation des dossiers" sclass="page-title"/>
                    <label value="Surveillez l'état des dossiers et ouvrez les documents associés"
                           sclass="page-subtitle"/>
                </div>
                <div class="header-actions">
                    <button label="@load(vm.filtersVisible ? 'Masquer les filtres' : 'Afficher les filtres')"
                            sclass="btn"
                            iconSclass="@load(vm.filtersVisible ? 'z-icon-chevron-up' : 'z-icon-chevron-down')"
                            onClick="@command('toggleFilters')"/>
                    <button label="Réinitialiser" sclass="btn" iconSclass="z-icon-undo"
                            onClick="@command('clearFilters')"/>
                </div>
            </div>

            <div class="filter-stack panel" visible="@load(vm.filtersVisible)">
                <vlayout hflex="1" style="gap: 10px;">
                    <hlayout hflex="1" style="gap: 10px;">
                        <div sclass="filter-pill flex-pill">
                            <combobox model="@load(vm.concoursList)" selectedItem="@bind(vm.selectedConcours)"
                                      autodrop="true" placeholder="Tous les concours"
                                      sclass="pill-input"
                                      onSelect="@command('applyFilters')"/>
                        </div>
                        <div sclass="filter-pill flex-pill">
                            <combobox model="@load(vm.centreList)" selectedItem="@bind(vm.selectedCentre)"
                                      autodrop="true" placeholder="Tous les centres"
                                      sclass="pill-input"
                                      onSelect="@command('applyFilters')"/>
                        </div>
                        <div sclass="filter-pill flex-pill">
                            <combobox model="@load(vm.documentTypes)" selectedItem="@bind(vm.selectedDocumentType)"
                                      autodrop="true" placeholder="Tous les documents"
                                      sclass="pill-input"
                                      onSelect="@command('applyFilters')"/>
                        </div>
                        <div sclass="filter-pill flex-pill">
                            <combobox model="@load(vm.etatFilterOptions)" selectedItem="@bind(vm.selectedEtatFilter)"
                                      autodrop="true" placeholder="Tous les états"
                                      sclass="pill-input"
                                      onSelect="@command('applyFilters')"/>
                        </div>
                        <button label="Réinitialiser" sclass="btn btn-secondary pill-reset"
                                iconSclass="z-icon-undo"
                                onClick="@command('clearFilters')"/>
                    </hlayout>
                    <hlayout hflex="1" style="gap: 10px;">
                        <div sclass="filter-pill flex-pill">
                            <textbox value="@bind(vm.searchNomCandidat)" placeholder="Rechercher un candidat"
                                     onOK="@command('applyFilters')" sclass="pill-input pill-input-search"/>
                        </div>
                    </hlayout>
                </vlayout>
                <label value="@load(vm.dossierCountLabel)" sclass="toolbar-counter"/>
            </div>

            <div class="selection-toolbar selection-toolbar--compact">
                <label value="@load(vm.summarySelectionLabel)" sclass="selection-count"/>
                <div class="selection-actions">
                    <button label="@load(vm.summaryToggleLabel)"
                            sclass="pill-btn pill-btn--ghost btn-sm"
                            onClick="@command('toggleSummarySelection')"
                            disabled="@load(empty vm.dossierSummaries)"/>
                    <button label="Valider" sclass="pill-btn pill-btn--primary btn-sm"
                            onClick="@command('bulkUpdateSummaries', etat=1)"
                            disabled="@load(empty vm.selectedSummaryRows)"/>
                    <button label="Rejeter" sclass="pill-btn pill-btn--danger btn-sm"
                            onClick="@command('bulkUpdateSummaries', etat=0)"
                            disabled="@load(empty vm.selectedSummaryRows)"/>
                    <button label="Revoir" sclass="pill-btn pill-btn--ghost btn-sm"
                            onClick="@command('bulkUpdateSummaries', etat=2)"
                            disabled="@load(empty vm.selectedSummaryRows)"/>
                </div>
            </div>

            <div class="panel validation-dossiers-panel scroll-panel" vflex="1">
                <listbox model="@load(vm.dossierSummaries)" sizedByContent="true"
                         checkmark="true" multiple="true"
                         selectedItems="@bind(vm.selectedSummaryRows)"
                         vflex="1" hflex="1" sclass="listbox-thread data-table"
                         emptyMessage="Aucun dossier à afficher avec ces filtres.">
                    <listhead>
                        <listheader label="N° INSCRIPTION" width="160px"/>
                        <listheader label="Concours" width="220px"/>
                        <listheader label="Centre" width="160px"/>
                        <listheader label="Documents" width="200px"/>
                        <listheader label="Statut" width="160px"/>
                        <listheader label="Remarque" hflex="2"/>
                    </listhead>
                    <template name="model" var="summary">
                        <listitem onDoubleClick="@command('openDossier', summary=summary)">
                            <listcell>
                                <label value="@load(summary.registrationLabel)" sclass="list-title"/>
                            </listcell>
                            <listcell>
                                <label value="@load(summary.concoursLabel)" sclass="text-ellipsis"/>
                            </listcell>
                            <listcell>
                                <label value="@load(summary.centreLabel)" sclass="text-ellipsis"/>
                            </listcell>
                            <listcell>
                                <vlayout spacing="4px">
                                    <label value="@load(summary.progressLabel)" sclass="text-muted"/>
                                    <div sclass="progress-shell">
                                        <div sclass="progress-bar" style="@load(summary.progressStyle)"></div>
                                    </div>
                                </vlayout>
                            </listcell>
                            <listcell>
                                <label value="@load(summary.statusLabel)" sclass="@load(summary.statusSclass)"/>
                            </listcell>
                            <listcell>
                                <textbox value="@bind(summary.remark)" hflex="1" rows="1"
                                         maxlength="255" placeholder="Remarque générale"/>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
        </vlayout>
    </div>
</zk>
