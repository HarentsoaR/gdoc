<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.PromotionViewModel')">

        <vlayout hflex="1" vflex="1" sclass="z-flex z-flex-col" style="gap: 16px;">
        
            <!-- En-tête de page -->
            <div sclass="page-header">
                <div>
                    <label value="Liste des Promotions" sclass="page-title"/>
                    <label value="Gérer les promotions existantes" sclass="page-subtitle"/>
                </div>
                <div sclass="header-actions">
                    <button label="Nouvelle Promotion" sclass="enmg-btn enmg-btn-primary" iconSclass="z-icon-plus"
                            onClick="@command('addPromotion')"/>
                </div>
            </div>

            <!-- Barre de filtres -->
            <div class="panel-body filter-bar">
                <div class="search-box" hflex="1">
                    <n:i class="z-icon-search search-icon" />
                    <textbox hflex="1" placeholder="Rechercher par libellé, numéro..."
                             value="@bind(vm.searchQuery)"
                             onOK="@command('search')" instant="true"/>
                </div>
                <button label="Rafraîchir" sclass="enmg-btn enmg-btn-secondary" iconSclass="z-icon-refresh" onClick="@command('search')"/>
            </div>

            <!-- Panneau du tableau -->
            <div class="panel enmg-card" vflex="1">
                <listbox model="@load(vm.promotionList)" emptyMessage="Aucune promotion trouvée." mold="paging" pageSize="10" vflex="1" sclass="data-table">
                    <listhead>
                        <listheader label="N° Promotion" sort="auto(numeroPromotion)"/>
                        <listheader label="Filière" sort="auto(filiere.libelle)"/>
                        <listheader label="Année Concours" sort="auto(anneeConcours)"/>
                        <listheader label="Actions" width="120px" align="center"/>
                    </listhead>
                    <template name="model" var="promo">
                        <listitem sclass="data-table-row">
                            <listcell label="@load(promo.numeroPromotion)"/>
                            <listcell label="@load(promo.filiere.libelle)"/>
                            <listcell label="@load(promo.anneeConcours)"/>
                            <listcell sclass="actions-cell">
                                <div hflex="1" align="center" style="display: flex; gap: 16px; justify-content: center;">
                                    <a iconSclass="z-icon-pencil" tooltiptext="Modifier"
                                       onClick="@command('edit', promotionToEdit=promo)"/>
                                    <a iconSclass="z-icon-trash" tooltiptext="Supprimer"
                                       onClick="@command('deletePromotion', id=promo.promotionId)"
                                       sclass="text-danger"/>
                                </div>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
            
        </vlayout>
    </div>
</zk>
