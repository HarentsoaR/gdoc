<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <!-- 
      NOUVEAU DASHBOARD - Inspiré de Google Drive
      - Structure en sections claires (Dossiers, Fichiers).
      - Utilise un listbox stylé pour la liste des fichiers.
    -->
    <div hflex="1" vflex="1" sclass="content-area dashboard"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.DashboardViewModel')">

        <!-- 1. En-tête de page -->
        <div sclass="page-header">
            <label value="Bienvenue dans GEDI Drive" sclass="page-title"/>
            <button sclass="btn-icon" iconSclass="z-icon-info-circle" />
        </div>

        <!-- 2. Section: Dossiers Suggérés (Cartes Horizontales) -->
        <div sclass="dashboard-section">
            <div sclass="section-header">
                <button sclass="btn-icon section-toggle"
                        iconSclass="@load(vm.showRecentFolders ? 'z-icon-angle-down' : 'z-icon-angle-right')"
                        onClick="@command('toggle', key='folders')" />
                <label value="Dossiers Récents" sclass="section-title" />
            </div>
            <!-- NOTE: On suppose que vm.recentFolders est une liste de vos dossiers -->
            <div sclass="suggested-folders-grid" visible="@load(vm.showRecentFolders)">
                 <forEach items="@load(vm.recentFolders)" var="doc">
                    <include src="/documents/components/documentCard.zul" doc="${doc}" />
                </forEach>
            </div>
        </div>

        <!-- 3. Section: Fichiers Suggérés (Liste Verticale) -->
        <div sclass="dashboard-section" vflex="1">
            <div sclass="section-header">
                 <button sclass="btn-icon section-toggle"
                         iconSclass="@load(vm.showRecentFiles ? 'z-icon-angle-down' : 'z-icon-angle-right')"
                         onClick="@command('toggle', key='files')" />
                <label value="Fichiers Récents" sclass="section-title" />
                <space hflex="1" />
                <!-- TODO: Ajouter le toggle List/Grid view plus tard -->
            </div>

            <!-- Conteneur de la liste pour qu'elle prenne la hauteur restante -->
            <div sclass="data-table-container file-list-table" vflex="1" visible="@load(vm.showRecentFiles)">
                 <!-- NOTE: On suppose que vm.recentFiles est une liste de vos fichiers -->
                <listbox model="@load(vm.recentFiles)" sclass="data-table" vflex="1" hflex="1" emptyMessage="Aucun document récent.">
                    <listhead sclass="data-table-header">
                        <listheader label="Nom" />
                        <listheader label="Dernière modification" width="250px" />
                        <listheader label="Emplacement" width="250px" />
                        <listheader label="" width="80px" align="center" />
                    </listhead>
                    <template name="model" var="file">
                        <listitem sclass="data-table-row">
                            <listcell sclass="data-table-cell">
                                <hlayout valign="center" spacing="12px">
                                    <!-- Icône dynamique basée sur le type de fichier -->
                                    <n:i sclass="@load(file.type eq 'pdf' ? 'z-icon-file-pdf-o file-icon-pdf' : 'z-icon-file-o file-icon-default')" />
                                    <label value="@load(file.titre)" />
                                </hlayout>
                            </listcell>
                            <listcell sclass="data-table-cell text-muted" label="@load('Modifié par vous • '.concat(file.dateUpload))" />
                            <listcell sclass="data-table-cell text-muted">
                                <hlayout valign="center" spacing="8px">
                                    <n:i sclass="z-icon-folder" />
                                    <label value="@load(file.emplacement)" />
                                </hlayout>
                            </listcell>
                            <listcell sclass="data-table-cell actions-cell">
                                <hlayout spacing="6px">
                                    <button sclass="btn-icon" iconSclass="z-icon-eye" tooltiptext="Voir"
                                            onClick="@command('viewFile', doc=file)" />
                                    <button sclass="btn-icon" iconSclass="z-icon-download" tooltiptext="Télécharger"
                                            onClick="@command('downloadFile', doc=file)" />
                                    <button sclass="btn-icon" iconSclass="z-icon-ellipsis-v" tooltiptext="Plus" />
                                </hlayout>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
        </div>
    </div>
</zk>