<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.DashboardViewModel')">

        <vlayout hflex="1" vflex="1" style="gap: 12px;">
            <div sclass="page-header">
                <div>
                    <label value="Accueil Concours" sclass="page-title"/>
                    <label value="@load('Actualisé : '.concat(vm.lastRefreshLabel))" sclass="page-subtitle"/>
                </div>
                <hlayout style="gap: 8px;">
                    <button label="Suivi dossiers" sclass="btn btn-secondary"
                            iconSclass="z-icon-line-chart"
                            onClick="@command('goToSuivi')"/>
                    <button label="Actualiser" sclass="btn"
                            iconSclass="z-icon-refresh"
                            onClick="@command('refreshDashboard')"/>
                </hlayout>
            </div>

           <!-- <div sclass="panel action-bar">
                <hlayout style="gap: 10px; align-items: center;">
                    <label value="Actions rapides" sclass="section-title"/>
                    <space hflex="1"/>
                    <button label="Valider dossiers" sclass="btn btn-primary"
                            iconSclass="z-icon-check"
                            onClick="@command('goToValidationDossiers')"/>
                    <button label="Valider documents" sclass="btn"
                            iconSclass="z-icon-file-text"
                            onClick="@command('goToValidationDocuments')"/>
                    <button label="Suivi des dossiers" sclass="btn"
                            iconSclass="z-icon-eye"
                            onClick="@command('goToSuivi')"/>
                    <button label="Gérer les concours" sclass="btn"
                            iconSclass="z-icon-cubes"
                            onClick="@command('goToConcoursList')"/>
                    <button label="Dépôt candidat" sclass="btn btn-secondary"
                            iconSclass="z-icon-upload"
                            onClick="@command('goToUpload')"/>
                </hlayout>
            </div>
            -->

            <hlayout hflex="1" style="gap: 12px;">
                <div sclass="panel" hflex="1" vflex="1">
                    <label value="État des dossiers" sclass="section-title"/>
                    <vlayout style="gap: 10px; margin-top: 8px;">
                        <forEach items="@load(vm.dossierStatusStats)" var="stat">
                            <vlayout>
                                <hlayout style="gap: 8px; align-items: center;">
                                    <label value="@load(stat.label)" sclass="list-title"/>
                                    <space hflex="1"/>
                                <label value="@load(stat.count)" sclass="text-muted"/>
                                <label value="@load(stat.percentLabel)" sclass="text-muted"/>
                            </hlayout>
                            <div sclass="progress-shell">
                                <div sclass="@load('progress-bar '.concat(stat.sclass))" style="@load(stat.widthStyle)"></div>
                            </div>
                        </vlayout>
                    </forEach>
                </vlayout>
            </div>
            </hlayout>

            <hlayout hflex="1" vflex="1" style="gap: 12px;">
                <div sclass="panel" hflex="1" vflex="1">
                    <hlayout style="align-items: center; gap: 8px;">
                        <label value="Documents récents" sclass="section-title"/>
                        <space hflex="1"/>
                        <button label="Actualiser" sclass="btn btn-ghost btn-sm"
                                iconSclass="z-icon-refresh"
                                onClick="@command('refreshDashboard')"/>
                    </hlayout>
                    <listbox model="@load(vm.recentDocuments)" vflex="1" hflex="1"
                             sizedByContent="false"
                             emptyMessage="Aucun document récent."
                             sclass="listbox-thread data-table"
                             mold="paging" pageSize="6">
                        <listhead>
                            <listheader label="Type" hflex="2"/>
                            <listheader label="Taille" width="120px"/>
                            <listheader label="Importé le" width="180px"/>
                            <listheader label="" width="80px"/>
                        </listhead>
                        <template name="model" var="doc">
                            <listitem>
                                <listcell>
                                    <label value="@load(doc.title)" sclass="list-title text-ellipsis"/>
                                </listcell>
                                <listcell>
                                    <label value="@load(doc.sizeLabel)" sclass="text-muted"/>
                                </listcell>
                                <listcell>
                                    <label value="@load(doc.importDateLabel)" sclass="text-muted"/>
                                </listcell>
                                <listcell>
                                    <button sclass="btn-icon" iconSclass="z-icon-download"
                                            tooltiptext="Télécharger"
                                            onClick="@command('downloadFile', doc=doc)"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                </div>
            </hlayout>
        </vlayout>
    </div>
</zk>
