<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <!-- 
      MODERNIZED SIDEBAR - Inspired by Google Drive
      - 'Nouveau' button is styled to be the primary action.
      - Flat navigation structure (no accordion) for easier scanning.
      - Added a storage information panel at the bottom.
    -->
    <vlayout sclass="sidebar" width="260px">
        
        <!-- Section 1: Main Action Button -->
        <div sclass="sidebar-section">
             <button label="Nouveau" sclass="btn-new" iconSclass="z-icon-plus"
                    onClick="@command('openUploadModal')" />
        </div>

        <!-- Section 2: Navigation Links -->
        <div sclass="sidebar-section sidebar-nav">
            <!-- ✅ NOUVEAU : Retour à l'accueil -->
            <button label="Retour à l'accueil" sclass="sidebar-button" iconSclass="z-icon-home"
                    onClick="@command('goHome')" />

            <button label="Tous les documents" sclass="sidebar-button active" iconSclass="z-icon-files-o"
                    onClick="@command('navigateTo', view='/documents/views/dashboard.zul', label='Mes Documents')" />
            <!-- <button label="Bibliothèque" sclass="sidebar-button" iconSclass="z-icon-book" />
            <button label="Projets" sclass="sidebar-button" iconSclass="z-icon-folder-o" />
            <button label="Partagés avec moi" sclass="sidebar-button" iconSclass="z-icon-users" /> -->
            <button label="Corbeille" sclass="sidebar-button" iconSclass="z-icon-trash-o" />
        </div>

        <separator/>
        
        <!-- Section 3: Concours Sub-Navigation (collapsible) -->
        <div sclass="sidebar-section sidebar-nav">
            <hlayout sclass="@load(vm.concoursExpanded ? 'sidebar-toggle open' : 'sidebar-toggle')"
                     onClick="@command('toggleConcoursSection')">
                <n:i class="z-icon-caret-right sidebar-caret" />
                <label value="Concours" sclass="sidebar-title no-padding" />
            </hlayout>
            <vlayout sclass="concours-subnav" visible="@load(vm.concoursExpanded)">
                <button label="Liste Concours" sclass="sidebar-button" iconSclass="z-icon-list"
                        onClick="@command('navigateTo', view='/documents/views/concours/list.zul', section='Concours', page='Liste Concours')" />
               <!-- <button label="Phases" sclass="sidebar-button" iconSclass="z-icon-tasks"
                        onClick="@command('navigateTo', view='/documents/views/concours/phases.zul', section='Concours', page='Phases')" />
                <button label="Centres" sclass="sidebar-button" iconSclass="z-icon-building"
                        onClick="@command('navigateTo', view='/documents/views/concours/centres.zul', section='Concours', page='Centres')" />
                <button label="Lieux" sclass="sidebar-button" iconSclass="z-icon-map-marker"
                        onClick="@command('navigateTo', view='/documents/views/concours/lieux.zul', section='Concours', page='Lieux')" /> -->
                <button label="Doc. Concours" sclass="sidebar-button" iconSclass="z-icon-file-text"
                        onClick="@command('navigateTo', view='/documents/views/concours/documents-concours/list.zul', section='Concours', page='Documents')" />
                <button label="Candidats" sclass="sidebar-button" iconSclass="z-icon-user-plus"
                        onClick="@command('navigateTo', view='/documents/views/candidats/list.zul', section='Concours', page='Candidats')" />
                <button label="Dossiers Candidats" sclass="sidebar-button" iconSclass="z-icon-folder-open"
                        onClick="@command('navigateTo', view='/documents/views/candidats/dossiers.zul', section='Concours', page='Dossiers Candidats')" />
            </vlayout>
        </div>

        <separator/>

        <!-- Section 4: Administration -->
        <div sclass="sidebar-section sidebar-nav">
            <label value="Administration" sclass="sidebar-title" />
            <vlayout>
                 <button label="Filières" sclass="sidebar-button" iconSclass="z-icon-graduation-cap"
                        onClick="@command('navigateTo', view='/documents/views/filiere/list.zul', section='Administration', page='Filières')" />
                 <button label="Promotions" sclass="sidebar-button" iconSclass="z-icon-bookmark"
                        onClick="@command('navigateTo', view='/documents/views/promotion/list.zul', section='Administration', page='Promotions')" />
            </vlayout>
        </div>

        <space vflex="1" /> <!-- Pushes the storage section to the bottom -->
        
        <!-- Section 4: Storage Information -->
        <div sclass="sidebar-section">
            <div sclass="sidebar-storage">
                <n:i class="z-icon-cloud" />
                <label value="Espace de stockage" sclass="storage-title"/>
                <progressmeter value="50" sclass="storage-progress"/>
                <label value="50 Go utilisés sur 100 Go" sclass="storage-text"/>
                <button label="Gérer le stockage" sclass="btn-storage" />
            </div>
        </div>
    </vlayout>
</zk>