<?page title="Connexion – GEDI"?>
<zk xmlns:n="native">

    <style>
        @import url('/css/enmg-theme.css');
        .z-page{
            margin:0;
            font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
            background:radial-gradient(circle at top,#f5f7fb,#e9eef6);
        }
        .login-container{
            min-height:100vh;
            display:flex;
            align-items:center;
            justify-content:center;
            padding:32px;
        }
        .login-card{
            width:100%;
            max-width:980px;
            display:flex;
            border-radius:28px;
            background:#fff;
            box-shadow:0 30px 60px rgba(15,23,42,.15);
            overflow:hidden;
        }
        .login-branding{
            flex:1;
            background:#fff;
            color:var(--enmg-color-text);
            padding:56px 48px;
            display:flex;
            flex-direction:column;
            justify-content:center;
            gap:24px;
            border-right:1px solid var(--enmg-color-border);
        }
        .login-branding-logo{
            width:140px;
            align-self:center;
        }
        .login-branding-title{
            font-size:34px;
            font-weight:700;
            letter-spacing:.5px;
            text-align:center;
        }
        .login-branding-subtitle{
            font-size:16px;
            opacity:.95;
            text-align:center;
            max-width:320px;
            align-self:center;
        }
        .login-form-panel{
            flex:1.1;
            padding:56px 64px;
            display:flex;
            flex-direction:column;
            justify-content:center;
        }
        .login-title{
            font-size:30px;
            font-weight:700;
            color:#0f172a;
        }
        .login-subtitle{
            font-size:16px;
            color:#6b7280;
            margin-bottom:32px;
        }
        .login-label{
            font-size:14px;
            font-weight:600;
            color:#374151;
            margin-bottom:6px;
        }
        .input-wrapper{position:relative;width:100%}
        .login-input.z-textbox{
            height:48px;
            border-radius:12px;
            border:1px solid #d4dae5;
            padding:0 14px 0 46px;
            font-size:15px;
            transition:all .2s ease;
        }
        .login-input.z-textbox:focus{
            border-color:#0f9d58;
            box-shadow:0 0 0 3px rgba(15,157,88,.2);
            outline:none;
        }
        .login-input-error.z-textbox{
            border-color:#ef4444!important;
            background:#fee2e2;
        }
        .input-icon{
            position:absolute;
            top:50%;
            transform:translateY(-50%);
            color:#94a3b8;
            font-size:18px;
        }
        .input-icon.left{left:14px}
        .input-icon.right{right:14px;cursor:pointer;color:#64748b}
        .input-icon.right:hover{color:#0f172a}
        .error-message{height:18px;font-size:13px;color:#dc2626}
        .login-button.z-button{
            height:48px;
            border:none;
            border-radius:12px;
            background:linear-gradient(135deg,#f97316,#f43f5e);
            color:#fff;
            font-weight:600;
            font-size:16px;
            transition:transform .2s ease,box-shadow .2s ease;
        }
        .login-button.z-button:hover{transform:translateY(-1px);box-shadow:0 12px 20px rgba(244,63,94,.3)}
        .login-button.z-button[disabled]{opacity:.7;cursor:not-allowed}
        .login-link.z-a{color:#2563eb;font-size:14px;text-align:center}
        .banner{position:fixed;top:24px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:10px;box-shadow:0 10px 25px rgba(0,0,0,.1);font-weight:600;z-index:1000}
        .banner-success{background:#e6fffa;color:#0f766e;border:1px solid #99f6e4}
        .banner-error{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}
        @media(max-width:940px){
            .login-card{flex-direction:column}
            .login-branding{padding:40px}
            .login-form-panel{padding:40px}
        }
    </style>

    <div sclass="login-container" viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.LoginViewModel')">
        
        <div id="flashBanner" sclass="@load(vm.bannerClass)" visible="@load(not empty vm.flashMessage)">
            <label value="@load(vm.flashMessage)" />
            <n:i sclass="@load(vm.bannerIconClass)" />
        </div>
        
        <div sclass="login-card">
            <div sclass="login-branding">
                <image src="/img/login.png" sclass="login-branding-logo"/>
                <label value="Gestion de Document Intelligent" sclass="login-branding-subtitle"/>
            </div>

            <div sclass="login-form-panel">
                <label value="Bienvenue !" sclass="login-title"/>
                <label value="Veuillez entrer vos identifiants pour continuer." sclass="login-subtitle"/>

                <vbox width="100%" spacing="15px">
                    <vbox width="100%" spacing="0">
                        <label value="Nom d'utilisateur" sclass="login-label"/>
                        <div sclass="input-wrapper">
                            <n:i sclass="z-icon-user input-icon left"/>
                            <textbox id="usernameBox" hflex="1" 
                                     sclass="login-input @load(vm.loginError ? 'login-input-error' : '')"
                                     placeholder="ex: jdupont"
                                     value="@save(vm.username) @load(vm.username)"
                                     onOK="@command('login')" />
                        </div>
                    </vbox>

                    <vbox width="100%" spacing="0">
                        <label value="Mot de passe" sclass="login-label"/>
                        <div sclass="input-wrapper">
                            <n:i sclass="z-icon-lock input-icon left"/>
                            <textbox id="passwordBox" hflex="1"
                                     sclass="login-input @load(vm.loginError ? 'login-input-error' : '')"
                                     placeholder="••••••••"
                                     type="@load(vm.passwordInputType)"
                                     value="@save(vm.password) @load(vm.password)"
                                     onOK="@command('login')" />
                            <a sclass="input-icon right"
                               iconSclass="@load(vm.passwordVisibilityIcon)"
                               onClick="@command('togglePasswordVisibility')"/>
                        </div>
                    </vbox>
                    
                    <label sclass="error-message" value="@load(vm.errorMessage)" />
                </vbox>

                <vbox width="100%" spacing="16px" style="margin-top: 24px;">
                    <!-- ✅ CORRECTION : La condition "loginDisabled" est enlevée. Le bouton est maintenant toujours activé. -->
                    <button id="loginButton" width="100%" sclass="login-button"
                            label="@load(vm.isLoggingIn ? 'Connexion...' : 'Se connecter')"
                            iconSclass="@load(vm.isLoggingIn ? 'spinner z-icon-spinner' : '')"
                            disabled="@load(vm.isLoggingIn)"
                            onClick="@command('login')"/>
                            
                    <a label="Mot de passe oublié ?" sclass="login-link" style="text-align: center;"/>
                </vbox>
            </div>
        </div>
    </div>
</zk>
