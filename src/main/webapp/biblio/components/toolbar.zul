<hlayout sclass="toolbar p-2 bg-light">
    <button label="Ajouter" onClick="@command('openNewDocumentModal')" />
    <button label="Importer" onClick="@command('openImportModal')" />
    <button label="Exporter" onClick="@command('exportData')" />
