<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">
    <!-- 
        Documents List - Manage all documents in the bibliothèque
        Provides CRUD operations for DocumentBiblio entities
    -->
    
    <div sclass="content-area">
        <label value="📚 Gestion des documents" sclass="biblio-section-title" />
        
        <!-- Toolbar -->
        <div style="margin-bottom: 20px;">
            <hlayout spacing="8px">
                <button label="Ajouter" sclass="enmg-btn enmg-btn-primary" iconSclass="z-icon-plus" />
                <button label="Importer" sclass="enmg-btn enmg-btn-secondary" iconSclass="z-icon-upload" />
                <button label="Exporter" sclass="enmg-btn enmg-btn-secondary" iconSclass="z-icon-download" />
                <button label="Rafraîchir" sclass="enmg-btn enmg-btn-secondary" iconSclass="z-icon-refresh" onClick="@command('loadDocuments')" />
                <button label="Recherche" sclass="enmg-btn enmg-btn-ghost" />
                <button label="Rapports" sclass="enmg-btn enmg-btn-secondary" />
            </hlayout>
        </div>
        
        <!-- Search and Filter -->
        <div sclass="z-panel" style="margin-bottom: 20px;">
            <div sclass="z-panel-header">
                <label sclass="z-panel-title" value="🔍 Recherche et filtres" />
            </div>
            <div sclass="z-panel-body">
                <vlayout>
                    <!-- Search Bar -->
                    <hlayout valign="middle" style="margin-bottom: 16px;">
                        <textbox placeholder="Rechercher par titre, auteur, ISBN..." 
                                 value="@bind(vm.searchQuery)" 
                                 onOK="@command('searchDocuments')" 
                                 hflex="1" />
                        <button label="Rechercher" 
                                iconSclass="z-icon-search"
                                onClick="@command('searchDocuments')" 
                                sclass="enmg-btn enmg-btn-primary"/>
                        <button label="Réinitialiser" 
                                iconSclass="z-icon-refresh"
                                onClick="@command('resetSearch')" 
                                sclass="enmg-btn enmg-btn-secondary"/>
                    </hlayout>
                    
                    <!-- Filter Row -->
                    <hlayout valign="middle">
                        <label value="Type:" style="width: 80px; font-weight: 500; color: var(--enmg-color-text);" />
                        <listbox mold="select" model="@load(vm.documentTypes)" 
                                selectedItem="@bind(vm.selectedDocumentType)" 
                                onSelect="@command('filterByType')" 
                                style="width: 180px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--enmg-color-border); margin-right: 20px;" />
                        
                        <label value="Domaine:" style="width: 80px; font-weight: 500; color: var(--enmg-color-text);" />
                        <listbox mold="select" model="@load(vm.domains)" 
                                selectedItem="@bind(vm.selectedDomain)" 
                                onSelect="@command('filterByDomain')" 
                                style="width: 180px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--enmg-color-border); margin-right: 20px;" />
                        
                        <label value="Disponibilité:" style="width: 100px; font-weight: 500; color: var(--enmg-color-text);" />
                        <listbox mold="select" model="@load(vm.availabilityOptions)" 
                                selectedItem="@bind(vm.selectedAvailability)" 
                                onSelect="@command('filterByAvailability')" 
                                style="width: 150px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--enmg-color-border);" />
                    </hlayout>
                </vlayout>
            </div>
        </div>
        
        <!-- Documents List -->
        <div sclass="panel enmg-card" vflex="1">
            <listbox model="@load(vm.pagedDocuments)"
                     emptyMessage="Aucun document trouvé."
                     mold="paging"
                     pageSize="10"
                     sclass="data-table">
                <listhead>
                    <listheader label="Titre" />
                    <listheader label="Auteur / Éditeur" />
                    <listheader label="Type" width="180px" />
                    <listheader label="Disponibilité" width="160px" />
                    <listheader label="Actions" width="160px" align="center"/>
                </listhead>
                <template name="model" var="each">
                    <listitem sclass="data-table-row">
                        <listcell>
                            <vlayout spacing="2px">
                                <label sclass="item-title" value="@load(each.titre)" />
                                <hlayout spacing="4px">
                                    <label sclass="item-subtitle" value="ISBN :" />
                                    <label sclass="item-subtitle" value="@load(each.numeroIsbn != null ? each.numeroIsbn : 'Non spécifié')" />
                                </hlayout>
                            </vlayout>
                        </listcell>
                        <listcell>
                            <vlayout spacing="2px">
                                <label sclass="item-title" value="@load(vm.getAuthorLabel(each))" />
                                <label sclass="item-subtitle" value="@load(vm.getPublisherLabel(each))" />
                            </vlayout>
                        </listcell>
                        <listcell>
                            <label sclass="item-title" value="@load(vm.getDocumentTypeLabel(each))" />
                        </listcell>
                        <listcell>
                            <label sclass="@load(each.disponibilite eq 1 ? 'status-available' : 'status-unavailable')"
                                   value="@load(each.disponibilite eq 1 ? 'Disponible' : 'Indisponible')" />
                        </listcell>
                        <listcell align="center">
                            <hlayout spacing="8px" style="justify-content:center;">
                                <button tooltiptext="Voir" iconSclass="z-icon-eye" sclass="btn-icon" onClick="@command('viewDocument', document=each)" />
                                <button tooltiptext="Modifier" iconSclass="z-icon-pencil" sclass="btn-icon" onClick="@command('editDocument', document=each)" />
                                <button tooltiptext="Supprimer" iconSclass="z-icon-trash-o" sclass="btn-icon btn-danger" onClick="@command('deleteDocument', document=each)" />
                            </hlayout>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </div>
        
        <!-- Pagination -->
        <div style="text-align: center; margin-top: 16px;">
            <hlayout style="display: inline-flex; align-items: center;">
                <button label="Précédent" onClick="@command('previousPage')" 
                        disabled="@load(vm.currentPageNumber le 1)" sclass="enmg-btn enmg-btn-secondary" />
                <label value="Page @load(vm.currentPageNumber) sur @load(vm.totalPages)" style="margin: 0 15px;" />
                <button label="Suivant" onClick="@command('nextPage')" 
                        disabled="@load(vm.currentPageNumber ge vm.totalPages)" sclass="enmg-btn enmg-btn-secondary" />
            </hlayout>
        </div>
    </div>
</zk>
