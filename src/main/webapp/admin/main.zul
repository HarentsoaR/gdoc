<?page title="GEDI - Administration" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <style src="/admin/style.css" />

    <window border="none"
            sclass="gedi-main-window"
            width="100%" height="100%"
            viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.AdminViewModel')">

        <div sclass="gedi-main-layout admin-shell">
            <include src="/admin/components/sidebar.zul"/>

            <div sclass="main-content-wrapper @load(vm.sidebarCollapsed ? 'shifted' : '') admin-content-wrapper">
                <include src="/admin/components/topbar.zul"/>

                <div sclass="content-area admin-content-area">
                    <include src="@load(vm.currentView)" mode="defer" />
                </div>
            </div>
        </div>
    </window>
</zk>
