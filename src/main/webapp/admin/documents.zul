<?page title="Documents | GEDI" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <style>
        .docs-container {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .docs-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .docs-table {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            padding: 16px;
        }
    </style>

    <div sclass="docs-container">
        <div sclass="docs-header">
            <label value="📄 Gestion des Documents" sclass="dashboard-title"/>
            <button label="Nouveau document" iconSclass="z-icon-plus" onClick="@command('newDocument')" />
        </div>

        <div sclass="docs-table">
            <grid mold="paging" pageSize="10" width="100%">
                <columns>
                    <column label="Nom du fichier" />
                    <column label="Auteur" />
                    <column label="Taille" />
                    <column label="Date" />
                    <column label="Actions" />
                </columns>
                <rows>
                    <row>
                        <label value="Rapport_Annuel_2024.pdf" />
                        <label value="Jean Dupont" />
                        <label value="2.4 MB" />
                        <label value="05/09/2025" />
                        <button label="Télécharger" />
                    </row>
                </rows>
            </grid>
        </div>
    </div>
</zk>
