<?page title="Documents | GEDI" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

    <div sclass="docs-container enmg-page">
        <div sclass="docs-header enmg-page-header">
            <label value="📄 Gestion des Documents" sclass="dashboard-title"/>
            <button label="Nouveau document" iconSclass="z-icon-plus"
                    sclass="enmg-btn enmg-btn-primary"
                    onClick="@command('newDocument')" />
        </div>

        <div sclass="docs-table enmg-card">
            <grid mold="paging" pageSize="10" width="100%">
                <columns>
                    <column label="Nom du fichier" />
                    <column label="Auteur" />
                    <column label="Taille" />
                    <column label="Date" />
                    <column label="Actions" />
                </columns>
                <rows>
                    <row>
                        <label value="Rapport_Annuel_2024.pdf" />
                        <label value="Jean Dupont" />
                        <label value="2.4 MB" />
                        <label value="05/09/2025" />
                        <button label="Télécharger" />
                    </row>
                </rows>
            </grid>
        </div>
    </div>
</zk>
