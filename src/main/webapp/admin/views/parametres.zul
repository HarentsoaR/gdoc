<?page title="Paramètres | GEDI" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <div sclass="settings-container enmg-page">
        <div sclass="settings-section enmg-card">
            <label sclass="enmg-card-title">⚙️ Paramètres Généraux</label>
            <grid width="100%">
                <rows>
                    <row>
                        <label value="Nom de l'application" />
                        <textbox value="GEDI" width="200px" />
                    </row>
                    <row>
                        <label value="Thème" />
                        <combobox>
                            <comboitem label="Clair" />
                            <comboitem label="Sombre" />
                        </combobox>
                    </row>
                    <row>
                        <button label="Sauvegarder" sclass="enmg-btn enmg-btn-primary" />
                    </row>
                </rows>
            </grid>
        </div>

        <div sclass="settings-section enmg-card">
            <label sclass="enmg-card-title">🔒 Sécurité</label>
            <label value="Changer le mot de passe administrateur" />
            <grid>
                <rows>
                    <row>
                        <label value="Ancien mot de passe" />
                        <textbox type="password" />
                    </row>
                    <row>
                        <label value="Nouveau mot de passe" />
                        <textbox type="password" />
                    </row>
                    <row>
                        <button label="Mettre à jour" sclass="enmg-btn enmg-btn-primary" />
                    </row>
                </rows>
            </grid>
        </div>
    </div>
</zk>
