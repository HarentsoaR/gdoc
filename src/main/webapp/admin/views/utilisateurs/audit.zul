<zk>
    <style src="/css/admin.css"/>

    <div hflex="1" vflex="1" class="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.AuditViewModel')">
        <vlayout hflex="1" vflex="1" style="gap: 12px;">
            <div sclass="page-header">
                <div>
                    <label value="Audit et Journalisation" sclass="page-title"/>
                    <label value="Suivez les connexions, opérations et révisions." sclass="page-subtitle"/>
                </div>
            </div>

            <div class="panel summary-inline">
                <div class="mini-card">
                    <label value="Connexions" sclass="mini-card-title"/>
                    <label value="@load(vm.connexionCount)" sclass="mini-card-value"/>
                </div>
                <div class="mini-card">
                    <label value="Historiques" sclass="mini-card-title"/>
                    <label value="@load(vm.historiqueCount)" sclass="mini-card-value"/>
                </div>
                <div class="mini-card">
                    <label value="Révisions" sclass="mini-card-title"/>
                    <label value="@load(vm.revisions.size())" sclass="mini-card-value"/>
                </div>
            </div>

            <div class="panel filter-stack">
                <hlayout hflex="1" style="gap: 8px; align-items: center; flex-wrap: wrap;">
                    <datebox value="@bind(vm.fromDate)" placeholder="De" format="dd/MM/yyyy" width="160px"/>
                    <datebox value="@bind(vm.toDate)" placeholder="À" format="dd/MM/yyyy" width="160px"/>
                    <textbox value="@bind(vm.searchOperation)" placeholder="Filtrer par opération" width="200px"/>
                    <textbox value="@bind(vm.keyword)" placeholder="Recherche (IP, utilisateur, table, avant/après)" width="260px"/>
                    <intbox value="@bind(vm.selectedUserId)" placeholder="ID utilisateur" width="150px"/>
                    <space hflex="1"/>
                    <button label="Filtrer" sclass="btn btn-primary" iconSclass="z-icon-filter"
                            onClick="@command('filter')"/>
                    <button label="Réinitialiser" sclass="btn btn-secondary" iconSclass="z-icon-undo"
                            onClick="@command('reset')"/>
                </hlayout>
            </div>

            <hlayout hflex="1" vflex="1" style="gap: 12px;">
                <div class="panel scroll-panel" hflex="1" vflex="1">
                    <label value="Connexions" sclass="section-title"/>
                    <div class="table-scroll" vflex="1" hflex="1">
                        <listbox model="@load(vm.connexions)" vflex="1" hflex="1"
                                 sizedByContent="false"
                                 emptyMessage="Aucune connexion trouvée."
                                 sclass="listbox-thread data-table">
                            <listhead sizable="true">
                                <listheader label="Utilisateur" hflex="2"/>
                                <listheader label="Date" width="180px"/>
                                <listheader label="IP" width="150px"/>
                                <listheader label="Navigateur" hflex="2"/>
                                <listheader label="Ordinateur" hflex="2"/>
                            </listhead>
                            <template name="model" var="cx">
                                <listitem>
                                    <listcell><label value="@load(cx.utilisateur)"/></listcell>
                                    <listcell><label value="@load(cx.dateDebut)"/></listcell>
                                    <listcell><label value="@load(cx.adresseIp)"/></listcell>
                                    <listcell><label value="@load(cx.navigateur)"/></listcell>
                                    <listcell><label value="@load(cx.ordinateur)"/></listcell>
                                </listitem>
                            </template>
                        </listbox>
                    </div>
                </div>

                <div class="panel scroll-panel" hflex="1" vflex="1">
                    <label value="Historique" sclass="section-title"/>
                    <div class="table-scroll" vflex="1" hflex="1">
                        <listbox model="@load(vm.historiques)" vflex="1" hflex="1"
                                 sizedByContent="false"
                                 emptyMessage="Aucun historique."
                                 sclass="listbox-thread data-table">
                            <listhead sizable="true">
                                <listheader label="Date" width="160px"/>
                                <listheader label="Opération" width="160px"/>
                                <listheader label="Table" width="160px"/>
                                <listheader label="Avant" hflex="2"/>
                                <listheader label="Après" hflex="2"/>
                                <listheader label="IP" width="140px"/>
                            </listhead>
                            <template name="model" var="h">
                                <listitem>
                                    <listcell><label value="@load(h.date)"/></listcell>
                                    <listcell><label value="@load(h.operation)"/></listcell>
                                    <listcell><label value="@load(h.table)"/></listcell>
                                    <listcell><label value="@load(h.avant)" sclass="text-muted text-ellipsis"/></listcell>
                                    <listcell><label value="@load(h.apres)" sclass="text-muted text-ellipsis"/></listcell>
                                    <listcell><label value="@load(h.adresseIp)"/></listcell>
                                </listitem>
                            </template>
                        </listbox>
                    </div>
                </div>
            </hlayout>

            <div class="panel scroll-panel" hflex="1">
                <label value="Révisions (revinfo)" sclass="section-title"/>
                <div class="table-scroll" vflex="1" hflex="1">
                    <listbox model="@load(vm.revisions)" hflex="1"
                             sizedByContent="false"
                             emptyMessage="Aucune révision."
                             sclass="data-table listbox-thread"
                             mold="paging" pageSize="10">
                        <listhead sizable="true">
                            <listheader label="REV" width="80px"/>
                            <listheader label="ID" width="100px"/>
                            <listheader label="Timestamp" width="180px"/>
                            <listheader label="Utilisateur" hflex="2"/>
                        </listhead>
                        <template name="model" var="rev">
                            <listitem>
                                <listcell label="@load(rev.rev)"/>
                                <listcell label="@load(rev.id)"/>
                                <listcell label="@load(rev.timestampLabel)"/>
                                <listcell label="@load(rev.username)"/>
                            </listitem>
                        </template>
                    </listbox>
                </div>
            </div>
        </vlayout>
    </div>
</zk>
