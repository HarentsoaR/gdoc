<?page title="Nouveau Profil" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

    <div hflex="1" vflex="1" class="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.ProfilViewModel')">

        <vlayout hflex="1" vflex="1" style="gap:16px;">

            <!-- HEADER -->
            <div class="page-header">
                <div>
                    <label class="page-title" value="Nouveau Profil"/>
                    <label class="page-subtitle" value="Créer un nouveau rôle utilisateur"/>
                </div>

                <hlayout spacing="10px">
                    <button label="Annuler"
                            sclass="btn"
                            onClick='@global-command("navigateToAdmin", view="/admin/views/profils/list.zul", section="Profils", page="Liste")'/>

                    <button label="Créer"
                            sclass="btn-primary"
                            onClick="@command('saveProfil')"/>
                </hlayout>
            </div>

            <!-- FORM PANEL -->
            <div class="form-panel" vflex="1">

                <label class="form-section-title">Informations du profil</label>

                <div class="form-row">
                    <div class="form-field">
                        <label class="form-label">Filière *</label>
                        <combobox model="@load(vm.filieres)"
                                  selectedItem="@bind(vm.selectedFiliere)"
                                  constraint="no empty"
                                  placeholder="Choisir une filière"
                                  autodrop="true"
                                  readonly="true"
                                  hflex="1">
                            <template name="model" var="f">
                                <comboitem label="@load(f.libelle)" description="@load(f.code)"/>
                            </template>
                        </combobox>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label class="form-label">Service</label>
                        <combobox model="@load(vm.services)"
                                  selectedItem="@bind(vm.selectedService)"
                                  placeholder="Choisir un service"
                                  autodrop="true"
                                  readonly="true"
                                  hflex="1">
                            <template name="model" var="s">
                                <comboitem label="@load(s.libelle)" description="@load(s.code)"/>
                            </template>
                        </combobox>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label class="form-label">Libellé *</label>
                        <textbox value="@bind(vm.currentProfil.libelle)"
                                 constraint="no empty"
                                 placeholder="Ex : Administrateur, Agent..."
                                 hflex="1"/>
                    </div>
                </div>

            </div>

        </vlayout>
    </div>

</zk>
