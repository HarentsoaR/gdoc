<?page title="Gestion des Profils" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:n="native">

    <div hflex="1" vflex="1" sclass="page-container"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.ProfilViewModel')">

        <vlayout hflex="1" vflex="1" style="gap:16px;">

            <div class="page-header">
                <div>
                    <label class="page-title" value="Gestion des Profils"/>
                    <label class="page-subtitle" value="Administration des rôles du système"/>
                </div>

                <hlayout spacing="10px">
                    <button label="Nouveau profil"
                            sclass="enmg-btn enmg-btn-primary"
                            iconSclass="z-icon-plus"
                            onClick="@command('openNewProfil')"/>
                </hlayout>
            </div>

            <div class="filter-bar">
                <div class="search-box" hflex="1">
                    <n:i class="z-icon-search search-icon"/>
                    <textbox value="@bind(vm.searchQuery)"
                             placeholder="Rechercher un profil..."
                             instant="true"
                             onOK="@command('searchProfils')"
                             hflex="1"/>
                </div>

                <button label="Rafraîchir"
                        sclass="enmg-btn enmg-btn-secondary"
                        iconSclass="z-icon-refresh"
                        onClick="@command('loadProfils')"/>
            </div>

            <div class="panel enmg-card" vflex="1">
                <listbox model="@load(vm.profils)"
                         emptyMessage="Aucun profil trouvé."
                         vflex="1"
                         mold="paging"
                         pageSize="10"
                         sclass="data-table">

                    <listhead sizable="true">
                        <listheader label="Libellé"/>
                        <listheader label="Actions" width="160px"/>
                    </listhead>

                    <template name="model" var="p">
                        <listitem sclass="data-table-row">
                            <listcell>
                                <label value="@load(p.libelle)" sclass="user-name"/>
                            </listcell>

                            <listcell>
                                <hlayout spacing="16px" style="justify-content:center;">
                                    <a iconSclass="z-icon-pencil"
                                       tooltiptext="Modifier"
                                       onClick="@command('openEditProfil', profil=p)"/>

                                    <a iconSclass="z-icon-trash-o"
                                       tooltiptext="Supprimer"
                                       sclass="text-danger"
                                       onClick="@command('deleteProfil', profil=p)"/>
                                </hlayout>
                            </listcell>
                        </listitem>
                    </template>

                </listbox>
            </div>

        </vlayout>
    </div>

</zk>
