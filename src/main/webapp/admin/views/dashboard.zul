<?page title="Tableau de bord | GEDI" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

    <div class="enmg-page dashboard-page" hflex="1" vflex="1"
         viewModel="@id('vm') @init('mg.md2i.gedi.control.viewmodel.AdminDashboardViewModel')">
        <vlayout sclass="dashboard-container" hflex="1" vflex="1">

            <div class="dashboard-header enmg-page-header">
                <div>
                    <label sclass="dashboard-title" value="📊 Tableau de bord GEDI"/>
                    <label sclass="dashboard-subtitle" value="@load('Actualisé : '.concat(vm.lastRefreshLabel))"/>
                </div>
                <button label="Actualiser"
                        onClick="@command('refreshDashboard')"
                        iconSclass="z-icon-refresh"
                        sclass="enmg-btn enmg-btn-primary"/>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <label class="stat-card-number" value="@load(vm.totalDocuments)"/>
                    <label class="stat-card-label" value="Documents gérés"/>
                </div>
                <div class="stat-card">
                    <label class="stat-card-number" value="@load(vm.totalDossiers)"/>
                    <label class="stat-card-label" value="@load(vm.validationRateLabel)"/>
                </div>
                <div class="stat-card">
                    <label class="stat-card-number" value="@load(vm.activeUsers)"/>
                    <label class="stat-card-label" value="@load(vm.activeUsersLabel)"/>
                </div>
                <div class="stat-card">
                    <label class="stat-card-number" value="@load(vm.storageUsageLabel)"/>
                    <label class="stat-card-label" value="Stockage consommé"/>
                </div>
            </div>

            <hlayout sclass="dashboard-grid">
                <div class="chart-card">
                    <label class="chart-card-title" value="État des dossiers"/>
                    <chart type="pie" threeD="true" height="240px" model="@load(vm.dossierPieModel)"
                           visible="@load(not empty vm.dossierStatusEntries)"/>
                    <label value="Aucune donnée"
                           visible="@load(empty vm.dossierStatusEntries)"
                           sclass="empty-message"/>
                </div>
                <div class="chart-card">
                    <label class="chart-card-title" value="Répartition du stockage par type"/>
                    <chart type="pie" threeD="true" height="240px" model="@load(vm.storagePieModel)"
                           visible="@load(not empty vm.storageStats)"/>
                    <label value="Aucune donnée de stockage"
                           visible="@load(empty vm.storageStats)"
                           sclass="empty-message"/>
                    <div class="storage-meter">
                        <progressmeter value="@load(vm.storageUsagePercent)" width="100%"/>
                        <label value="@load(vm.storageUsageText)"/>
                    </div>
                </div>
            </hlayout>

            <hlayout sclass="dashboard-grid">
                <div class="chart-card chart-card--wide">
                    <label class="chart-card-title" value="Documents par concours (Top 8)"/>
                    <chart type="bar" height="300px" model="@load(vm.concoursBarModel)"
                           visible="@load(not empty vm.concoursStats)"/>
                    <label value="Aucun concours référencé"
                           visible="@load(empty vm.concoursStats)"
                           sclass="empty-message"/>
                </div>
                <div class="chart-card">
                    <label class="chart-card-title" value="Tendance des imports (6 derniers mois)"/>
                    <chart type="line" height="300px" model="@load(vm.trendLineModel)"
                           visible="@load(not empty vm.trendStats)"/>
                    <label value="Aucun import durant cette période"
                           visible="@load(empty vm.trendStats)"
                           sclass="empty-message"/>
                </div>
            </hlayout>

            <hlayout sclass="dashboard-grid">
                <div class="chart-card">
                    <label class="chart-card-title" value="Durée des concours (jours)"/>
                    <chart type="bar" height="280px" model="@load(vm.timelineModel)"
                           visible="@load(not empty vm.timelineStats)"/>
                    <label value="Aucun concours planifié"
                           visible="@load(empty vm.timelineStats)"
                           sclass="empty-message"/>
                </div>
                <div class="chart-card">
                    <label class="chart-card-title" value="Activité d'import (35 derniers jours)"/>
                    <chart type="bar" height="280px" model="@load(vm.heatmapModel)"
                           visible="@load(not empty vm.heatmapStats)"/>
                    <label value="Aucun import récent"
                           visible="@load(empty vm.heatmapStats)"
                           sclass="empty-message"/>
                </div>
            </hlayout>

            <div class="panel enmg-card" hflex="1" vflex="1">
                <label class="panel-title" value="Derniers documents importés"/>
                <listbox model="@load(vm.recentDocuments)"
                         vflex="1"
                         emptyMessage="Aucun document disponible."
                         mold="paging"
                         pageSize="6"
                         sclass="data-table">
                    <listhead>
                        <listheader label="Titre" width="280px"/>
                        <listheader label="Type" width="130px"/>
                        <listheader label="Taille"/>
                        <listheader label="Date d'import"/>
                    </listhead>
                    <template name="model" var="doc">
                        <listitem>
                            <listcell>
                                <vlayout>
                                    <label value="@load(doc.titre)" sclass="list-title"/>
                                    <label value="@load(doc.resume)" sclass="text-muted" visible="@load(not empty doc.resume)"/>
                                </vlayout>
                            </listcell>
                            <listcell label="@load(doc.type)"/>
                            <listcell label="@load(vm.formatSize(doc.taille))"/>
                            <listcell label="@load(vm.formatDate(doc.dateUpload))"/>
                        </listitem>
                    </template>
                </listbox>
            </div>

        </vlayout>
    </div>
</zk>
