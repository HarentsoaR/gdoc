<?page title="Tableau de bord | GEDI" contentType="text/html;charset=UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

    <style>
        .dashboard-container {
            display: flex;
            flex-direction: column;
            gap: 24px;
            width: 100%;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dashboard-title {
            font-size: 24px;
            font-weight: 600;
            color: #1e293b;
        }

        .cards-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
            transition: transform 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        .stat-title {
            font-size: 14px;
            color: #64748b;
        }

        .stat-value {
            font-size: 28px;
            font-weight: bold;
            color: #1e293b;
        }

        .chart-area {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            padding: 16px;
            flex: 1;
            min-height: 300px;
        }

        .table-area {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            padding: 16px;
            flex: 1;
        }
    </style>

    <div sclass="dashboard-container">
        <div sclass="dashboard-header">
            <label sclass="dashboard-title" value="📊 Tableau de bord GEDI" />
            <button label="Actualiser" onClick="@command('refreshDashboard')" sclass="btn btn-primary" />
        </div>

        <div sclass="cards-row">
            <div sclass="stat-card">
                <label sclass="stat-title" value="Documents" />
                <label sclass="stat-value" value="1 245" />
            </div>
            <div sclass="stat-card">
                <label sclass="stat-title" value="Utilisateurs actifs" />
                <label sclass="stat-value" value="58" />
            </div>
            <div sclass="stat-card">
                <label sclass="stat-title" value="Stock utilisé" />
                <label sclass="stat-value" value="72%" />
            </div>
            <div sclass="stat-card">
                <label sclass="stat-title" value="Dernière synchronisation" />
                <label sclass="stat-value" value="il y a 5 min" />
            </div>
        </div>

        <div sclass="cards-row">
            <div sclass="chart-area">
                <label value="📈 Activité récente (graphe simulé)" />
                <separator />
                <!-- placeholder sample data -->
                <progressmeter value="60" width="100%" />
            </div>
            <div sclass="table-area">
                <label value="📋 Derniers documents ajoutés" />
                <separator />
                <grid mold="paging" pageSize="5" width="100%">
                    <columns>
                        <column label="Nom" />
                        <column label="Auteur" />
                        <column label="Date" />
                    </columns>
                    <rows>
                        <row>
                            <label value="Contrat_A2025.pdf" />
                            <label value="Marie Dupont" />
                            <label value="09/10/2025" />
                        </row>
                        <row>
                            <label value="Facture_Juillet.pdf" />
                            <label value="Admin" />
                            <label value="08/10/2025" />
                        </row>
                        <row>
                            <label value="PV_Réunion.docx" />
                            <label value="Paul Martin" />
                            <label value="08/10/2025" />
                        </row>
                    </rows>
                </grid>
            </div>
        </div>
    </div>
</zk>
