<zk>
    <style>
        .layout { display:flex; height:100%; background:#f7f8fa; }
        .sidebar { width:240px; background:#ffffff; border-right:1px solid #e5e7eb; padding:16px 0; }
        .nav-item { display:flex; align-items:center; gap:10px; padding:10px 16px; color:#374151; cursor:pointer; }
        .nav-item:hover { background:#f3f4f6; }
        .nav-item--active { background:#e8f0fe; color:#1d4ed8; font-weight:600; border-right:3px solid #1d4ed8; }
        .content { flex:1; padding:24px 28px; overflow:auto; }
        .section { background:#fff; border-radius:12px; box-shadow:0 8px 24px rgba(0,0,0,.06); padding:18px 18px; }
        .section-title { font-size:18px; font-weight:700; color:#111827; margin-bottom:8px; }
        .muted { color:#6b7280; }
        .divider { height:1px; background:#e5e7eb; margin:16px 0; }
        .btn { height:36px; border:none; border-radius:8px; color:#fff; padding:0 12px; font-weight:600; }
        .btn-primary { background:#1d4ed8; }
        .btn-success { background:#10b981; }
        .btn-outline { background:#fff; color:#374151; border:1px solid #e5e7eb; }
        .pill { background:#f3f4f6; color:#374151; border-radius:999px; padding:4px 10px; font-size:12px; }
        .user-row { display:flex; align-items:center; justify-content:space-between; padding:10px 0; }
        .user-meta { display:flex; align-items:center; gap:12px; }
        .avatar { width:36px; height:36px; border-radius:999px; background:#e5e7eb; }
        .role-select { width:160px; }
        .toggle { width:48px; height:28px; border-radius:14px; background:#e5e7eb; position:relative; cursor:pointer; }
        .toggle::after { content:""; width:22px; height:22px; border-radius:999px; background:#fff; position:absolute; top:3px; left:3px; box-shadow:0 1px 3px rgba(0,0,0,.2); }
        .toggle--on { background:#10b981; }
        .toggle--on::after { left:23px; }
    </style>

    <window title="Paramètres et Préférences" border="none" width="100%" height="100%"
            apply="mg.md2i.gedi.security.SessionFilter,mg.md2i.gedi.control.AdminController">
        <div sclass="layout">
            <!-- Sidebar -->
            <vlayout sclass="sidebar">
                <hlayout style="padding:0 16px 12px; align-items:center; gap:10px;">
                    <image src="/img/logo-gedi.png" width="24px" height="24px"/>
                    <label value="GEDI" style="font-weight:700;color:#111827"/>
                </hlayout>
                <div sclass="nav-item nav-item--active" id="nav-docs">Gestion des documents</div>
                <div sclass="nav-item" id="nav-share">Partage de fichiers</div>
                <div sclass="nav-item" id="nav-search">Recherche Avancée</div>
                <div sclass="nav-item" id="nav-settings">Paramètres</div>
            </vlayout>

            <!-- Content -->
            <vlayout sclass="content" spacing="16px">
                <label value="Paramètres et Préférences" style="font-size:22px;font-weight:700;color:#111827"/>

                <!-- User management -->
                <vlayout sclass="section" spacing="12px">
                    <label value="Gestion des comptes utilisateurs" style="font-weight:700"/>
                    <label value="Gérer les utilisateurs, les rôles et les accès." sclass="muted"/>
                    <div class="divider"/>

                    <hlayout hflex="1" style="justify-content:space-between; align-items:center;">
                        <label value="Liste des utilisateurs" style="font-weight:700"/>
                        <button id="userAddBtn" label="Ajouter un utilisateur" sclass="btn btn-success"/>
                    </hlayout>

                    <!-- user rows (static placeholders ready for data binding) -->
                    <vlayout spacing="10px">
                        <div sclass="user-row">
                            <hlayout sclass="user-meta">
                                <div sclass="avatar"/>
                                <vlayout>
                                    <label value="Alice Dupont"/>
                                    <label value="alice.dupont@gedi.com" sclass="muted"/>
                                </vlayout>
                            </hlayout>
                            <hlayout spacing="10px" style="align-items:center;">
                                <combobox sclass="role-select">
                                    <comboitem label="Administrateur"/>
                                    <comboitem label="Agent"/>
                                    <comboitem label="Lecteur"/>
                                </combobox>
                                <button label="✏️" sclass="btn btn-outline"/>
                                <button label="🗑" sclass="btn btn-outline"/>
                            </hlayout>
                        </div>
                        <div sclass="user-row">
                            <hlayout sclass="user-meta">
                                <div sclass="avatar"/>
                                <vlayout>
                                    <label value="Marc Dubois"/>
                                    <label value="marc.dubois@gedi.com" sclass="muted"/>
                                </vlayout>
                            </hlayout>
                            <hlayout spacing="10px" style="align-items:center;">
                                <combobox sclass="role-select">
                                    <comboitem label="Administrateur"/>
                                    <comboitem label="Agent"/>
                                    <comboitem label="Lecteur"/>
                                </combobox>
                                <button label="✏️" sclass="btn btn-outline"/>
                                <button label="🗑" sclass="btn btn-outline"/>
                            </hlayout>
                        </div>
                        <div sclass="user-row">
                            <hlayout sclass="user-meta">
                                <div sclass="avatar"/>
                                <vlayout>
                                    <label value="Sophie Leclerc"/>
                                    <label value="sophie.leclerc@gedi.com" sclass="muted"/>
                                </vlayout>
                            </hlayout>
                            <hlayout spacing="10px" style="align-items:center;">
                                <combobox sclass="role-select">
                                    <comboitem label="Administrateur"/>
                                    <comboitem label="Agent"/>
                                    <comboitem label="Lecteur"/>
                                </combobox>
                                <button label="✏️" sclass="btn btn-outline"/>
                                <button label="🗑" sclass="btn btn-outline"/>
                            </hlayout>
                        </div>
                    </vlayout>
                </vlayout>

                <!-- Security parameters -->
                <vlayout sclass="section" spacing="12px">
                    <label value="Paramètres de sécurité" style="font-weight:700"/>
                    <label value="Gérer les politiques de chiffrement et de contrôle d'accès." sclass="muted"/>
                    <div class="divider"/>

                    <vlayout spacing="8px">
                        <label value="Chiffrement et accès" style="font-weight:700"/>
                        <label value="Activer le chiffrement de bout en bout"/>
                        <div sclass="toggle toggle--on" id="toggleE2E"/>
                        <label value="Exiger l’authentification multifacteur (MFA)"/>
                        <div sclass="toggle" id="toggleMFA"/>
                    </vlayout>
                </vlayout>
            </vlayout>
        </div>
    </window>
</zk>
