<?component name="navbar" src="/includes/navbar.zul"?>
<?component name="sidebar" src="/includes/sidebar.zul"?>
<?component name="breadcrumb" src="/includes/breadcrumb.zul"?>

<zk>
    <style src="/css/admin.css"/>
    
    <window title="Audit et Journalisation" border="none" width="100%" height="100%">
        
        <div sclass="layout">
            <sidebar currentPage="audit"/>
            
            <vlayout sclass="content" spacing="16px">
                <navbar/>
                <breadcrumb currentPage="audit"/>
                
                <vlayout>
                    <label value="Audit et Journalisation" style="font-size:22px;font-weight:700;color:#111827"/>
                    <label value="Consulter les logs et activités du système." sclass="muted"/>
                </vlayout>
                
                <vlayout sclass="section" spacing="16px">
                    <hlayout style="justify-content:space-between; align-items:center;">
                        <label value="Journal des activités" style="font-weight:700; font-size:16px;"/>
                        <hlayout spacing="8px">
                            <datebox placeholder="De" format="dd/MM/yyyy"/>
                            <datebox placeholder="À" format="dd/MM/yyyy"/>
                            <button label="Filtrer" sclass="btn btn-primary"/>
                        </hlayout>
                    </hlayout>
                    
                    <div class="divider"/>
                    
                    <label value="Interface audit à implémenter avec vos entités AuditTrail"/>
                </vlayout>
            </vlayout>
        </div>
    </window>
</zk>