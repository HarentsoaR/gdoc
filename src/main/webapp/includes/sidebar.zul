<zk xmlns="http://www.zkoss.org/2005/zul">
<div sclass="@load(vm.sidebarVisible ? 'sidebar-expanded' : 'sidebar-collapsed')"
     style="background:#0f172a;color:white;padding:16px 0;
            display:flex;flex-direction:column;gap:12px;height:100%;box-sizing:border-box;
            transition:all 0.3s ease;overflow:hidden;position:relative;">

    <style>
        /* --- SIDEBAR BRAND HEADER --- */
        .sidebar-header {
            display:flex;
            align-items:center;
            gap:10px;
            margin-bottom:24px;
            padding:8px 22px;
            border-radius:8px;
            background:linear-gradient(135deg,#1e3a8a,#312e81);
            box-shadow:0 2px 8px rgba(0,0,0,0.2);
        }
        .sidebar-header .logo {
            width:36px;height:36px;
            border-radius:8px;
            background:linear-gradient(135deg,#38bdf8,#6366f1);
            display:flex;align-items:center;justify-content:center;
            font-weight:800;font-size:16px;color:white;
        }
        .sidebar-header .brand-name {
            font-weight:700;
            font-size:18px;
            letter-spacing:0.5px;
        }

        /* --- MENU STYLES --- */
        .menu-section {
            font-size:12px;
            font-weight:600;
            color:#94a3b8;
            text-transform:uppercase;
            margin-top:16px;
            margin-bottom:4px;
            padding:0 22px;
            opacity:0.8;
        }

        .menu-item {
            padding:10px 22px;
            border-radius:8px;
            cursor:pointer;
            transition:background 0.3s ease, padding-left 0.3s ease;
            display:flex;align-items:center;justify-content:flex-start;
            font-size:14px;
            gap:10px;
            color:#e2e8f0;
        }
        .menu-item:hover {
            background:#334155;
            color:white;
            padding-left:26px;
        }

        .menu-icon {
            width:22px;
            text-align:center;
            font-size:16px;
        }

        /* --- SUBMENU --- */
        .submenu {
            display:flex;
            flex-direction:column;
            margin-left:30px;
            gap:4px;
            overflow:hidden;
            max-height:0;
            transition:max-height 0.3s ease;
        }
        .submenu.open {
            max-height:300px;
        }

        .submenu-item {
            padding:8px 14px;
            border-radius:6px;
            cursor:pointer;
            transition:background 0.3s ease, padding-left 0.3s ease;
            color:#cbd5e1;
            font-size:13px;
        }
        .submenu-item:hover {
            background:#475569;
            color:white;
            padding-left:20px;
        }

        /* --- NOUVEAU : Bouton de retour et de bascule --- */
        .sidebar-footer {
            margin-top: auto; /* Pousse le pied de page en bas */
            padding: 8px 0;
            border-top: 1px solid #1e293b;
        }
        .sidebar-footer .menu-item:hover {
            padding-left: 22px; /* Garde le padding cohérent */
        }
        .sidebar-toggle-icon {
            transition: transform 0.3s ease;
        }
        .sidebar-collapsed .sidebar-toggle-icon {
            transform: rotate(180deg);
        }
        .sidebar-collapsed .sidebar-header {
            padding: 8px 0;
            justify-content: center;
        }
        /* --- COLLAPSED MODE --- */
        .sidebar-collapsed .brand-name,
        .sidebar-collapsed .menu-section,
        .sidebar-collapsed span {
            display:none !important;
        }

        .sidebar-collapsed .menu-item {
            justify-content: center;
            padding:10px 0;
        }

        .sidebar-collapsed .submenu {
            display:none !important;
        }
    </style>

    <!-- BRAND -->
    <div class="sidebar-header">
        <div class="logo">G</div>
        <label value="GEDI" sclass="brand-name"/>
    </div>

    <!-- ✅ NOUVEAU : Retour à l'accueil -->
    <div sclass="menu-item" onClick="@command('goHome')">
        <label value="↩️" sclass="menu-icon"/>
        <span>Retour à l'accueil</span>
    </div>

    <!-- SECTION: MAIN -->
    <label value="Navigation" sclass="menu-section"/>

    <div sclass="menu-item" onClick="@command('navigateTo', page='/admin/dashboard.zul')">
        <label value="🏠" sclass="menu-icon"/>
        <span>Tableau de bord</span>
    </div>

    <!-- USERS -->
    <div sclass="menu-item" onClick="@command('toggleUsersMenu')">
        <label value="👥" sclass="menu-icon"/>
        <span>Utilisateurs</span>
        <label value="@load(vm.usersMenuOpen ? '▾' : '▸')" style="margin-left:auto;color:#94a3b8;"/>
    </div>

    <vlayout sclass="@load(vm.usersMenuOpen ? 'submenu open' : 'submenu')">
        <div sclass="submenu-item" onClick="@command('navigateTo', page='/admin/utilisateurs/list.zul')">📋 Liste</div>
        <div sclass="submenu-item" onClick="@command('navigateTo', page='/admin/utilisateurs/new.zul')">➕ Nouveau</div>
        <div sclass="submenu-item" onClick="@command('navigateTo', page='/admin/utilisateurs/profils.zul')">🧩 Profils</div>
        <div sclass="submenu-item" onClick="@command('navigateTo', page='/admin/utilisateurs/acces.zul')">🔑 Accès</div>
        <div sclass="submenu-item" onClick="@command('navigateTo', page='/admin/utilisateurs/audit.zul')">🕵️ Audit</div>
    </vlayout>

    <!-- SECTION: MANAGEMENT -->
    <label value="Gestion" sclass="menu-section"/>

    <div sclass="menu-item" onClick="@command('navigateTo', page='/documents/documents.zul')">
        <label value="📄" sclass="menu-icon"/>
        <span>Documents</span>
    </div>

    <div sclass="menu-item" onClick="@command('navigateTo', page='/biblio/biblio.zul')">
        <label value="📚" sclass="menu-icon"/>
        <span>Bibliothèque</span>
    </div>

    <div sclass="menu-item" onClick="@command('navigateTo', page='/admin/parametres.zul')">
        <label value="⚙️" sclass="menu-icon"/>
        <span>Paramètres</span>
    </div>

    <!-- ✅ NOUVEAU : Pied de page avec bascule et déconnexion -->
    <div sclass="sidebar-footer">
        <div sclass="menu-item" onClick="@command('doLogout')">
            <label value="🚪" sclass="menu-icon"/>
            <span>Déconnexion</span>
        </div>
        <div sclass="menu-item" onClick="@command('toggleSidebar')">
            <label value="@load(vm.sidebarVisible ? '❮' : '❯')"
                   sclass="menu-icon sidebar-toggle-icon"/>
            <span>Réduire</span>
        </div>
    </div>
</div>
</zk>
